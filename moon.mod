  "md5",
  "sha256",
  "sha512",
  "sha3",
  "shake",
  "blake2",
  "blake3",
  "hmac",
  "poly1305",
  "aes",
  "chacha20",
  "aead",
  "kdf",
  "base64",
  "hex",
  "crc32",
  "siphash",
  "cmac",
  "sealed-box",
  "scrypt",
  "rsa",
  "oaep",
  "pss",
]

description = "Pure-MoonBit crypto primitives: MD5, SHA-2/SHA-3, SHAKE, BLAKE2b/BLAKE3, HMAC/Poly1305/CMAC, AES-CBC/GCM/CTR, ChaCha20(-Poly1305), HKDF/PBKDF2/scrypt, RSA (PKCS1-v1.5/OAEP/PSS), SipHash, CRC32/CRC32C, Base64/Hex, sealed-box envelope"
