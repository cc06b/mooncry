// ==================== X25519 (RFC 7748) ====================
// Vectors cross-checked against the `cryptography` library (X25519).

///|
let x25519_alice_priv : Bytes = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"

///|
let x25519_alice_pub : Bytes = b"\x8f\x40\xc5\xad\xb6\x8f\x25\x62\x4a\xe5\xb2\x14\xea\x76\x7a\x6e\xc9\x4d\x82\x9d\x3d\x7b\x5e\x1a\xd1\xba\x6f\x3e\x21\x38\x28\x5f"

///|
let x25519_bob_priv : Bytes = b"\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f"

///|
let x25519_bob_pub : Bytes = b"\x35\x80\x72\xd6\x36\x58\x80\xd1\xae\xea\x32\x9a\xdf\x91\x21\x38\x38\x51\xed\x21\xa2\x8e\x3b\x75\xe9\x65\xd0\xd2\xcd\x16\x62\x54"

///|
let x25519_shared : Bytes = b"\x96\x63\xaa\x1d\xa9\x7e\x84\x8a\x91\x4a\x43\x6d\x04\x16\x3d\xfb\xb8\x91\x78\xf1\x07\xf1\xb5\xb7\x7e\xd3\x85\x42\x03\x38\x28\x54"

///|
test "X25519: public key from private scalar (Alice)" {
  assert_true(
    bytes_equal(x25519_public_key(x25519_alice_priv), x25519_alice_pub),
  )
}

///|
test "X25519: public key from private scalar (fixed)" {
  let priv2 = b"\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0"
  assert_true(
    bytes_equal(
      x25519_public_key(priv2),
      b"\xf0\xb4\xfd\x8b\xe4\x80\x34\x92\x93\xab\x61\xf0\x50\x5e\xbb\x5b\xaf\xcc\xdf\x8a\x41\x27\xde\x22\x1e\x6e\xf3\xdb\x20\xe0\x3d\x29",
    ),
  )
}

///|
test "X25519: DH shared secret (Alice x Bob_pub)" {
  assert_true(
    bytes_equal(x25519(x25519_alice_priv, x25519_bob_pub), x25519_shared),
  )
}

///|
test "X25519: DH symmetry (Bob x Alice_pub == shared)" {
  assert_true(
    bytes_equal(x25519(x25519_bob_priv, x25519_alice_pub), x25519_shared),
  )
}
