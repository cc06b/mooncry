///|
test "falcon-m5b-sign-official-sig3" {
  let got = m5b_sign_with_ctr(3, 200)
  let exp = m5b_sig3()
  inspect(got.length(), content="655")
  inspect(bytes_equal(got, exp), content="true")
  // and it must verify against the official pk-less path: rebuild pk
  // verification via the m3 pk
  inspect(falcon512_verify(m3_pk(), got, m5b_msg(3, 200)), content="true")
}
