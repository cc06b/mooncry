///|
test "falcon-m5b-sign-official-sig2" {
  let got = m5b_sign_with_ctr(2, 64)
  let exp = m5b_sig2()
  inspect(got.length(), content="658")
  inspect(bytes_equal(got, exp), content="true")
  // and it must verify against the official pk-less path: rebuild pk
  // verification via the m3 pk
  inspect(falcon512_verify(m3_pk(), got, m5b_msg(2, 64)), content="true")
}

///|
fn m5b_sig3() -> Bytes {
  let a : Array[Byte] = [
    (0x39).to_byte(),
    (0xFC).to_byte(),
    (0x56).to_byte(),
    (0x55).to_byte(),
    (0x77).to_byte(),
    (0x91).to_byte(),
    (0x25).to_byte(),
    (0xE9).to_byte(),
    (0xF5).to_byte(),
    (0xFC).to_byte(),
    (0x36).to_byte(),
    (0xA2).to_byte(),
