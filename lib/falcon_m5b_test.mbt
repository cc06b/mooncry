// Falcon M5b tests: deterministic signing reproduces the official
// PQClean C signatures byte-for-byte (nonce/seed from the stub
// randombytes stream, counters 1,2 for sig0 / 3,4 for sig1 / ...).

///|
fn m5b_msg(t : Int, len : Int) -> Bytes {
  let a : Array[Byte] = []
  for i = 0; i < len; i = i + 1 {
    a.push(((i * 31 + t * 7) & 0xFF).to_byte())
  }
  Bytes::from_array(a)
}

///|
fn m5b_sign_with_ctr(t : Int, len : Int) -> Bytes {
  let r = falcon_test_rng_init()
  falcon_test_rng_set_ctr(r, (1 + 2 * t).to_uint64())
  let myrand = fn(k : Int) -> Bytes { falcon_test_rng_bytes(r, k) }
  falcon512_sign(m5b_sk(), m5b_msg(t, len), myrand)
}

