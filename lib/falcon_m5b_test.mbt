///|
test "falcon-m5b-sign-official-sig1" {
  let got = m5b_sign_with_ctr(1, 3)
  let exp = m5b_sig1()
  inspect(got.length(), content="656")
  inspect(bytes_equal(got, exp), content="true")
  // and it must verify against the official pk-less path: rebuild pk
  // verification via the m3 pk
  inspect(falcon512_verify(m3_pk(), got, m5b_msg(1, 3)), content="true")
}

///|
fn m5b_sig2() -> Bytes {
  let a : Array[Byte] = [
    (0x39).to_byte(),
    (0x01).to_byte(),
