// ==================== Salsa20 (eSTREAM) ====================
// Vectors cross-checked against pycryptodome (Crypto.Cipher.Salsa20).

///|
test "Salsa20: keystream block 0 (32-byte key)" {
  let block = salsa20_keystream_block(
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x00\x00\x00\x00\x00\x00\x00\x00", 0,
  )
  assert_true(
    bytes_equal(
      block, b"\x9a\x97\xf6\x5b\x9b\x4c\x72\x1b\x96\x0a\x67\x21\x45\xfc\xa8\xd4\xe3\x2e\x67\xf9\x11\x1e\xa9\x79\xce\x9c\x48\x26\x80\x6a\xee\xe6\x3d\xe9\xc0\xda\x2b\xd7\xf9\x1e\xbc\xb2\x63\x9b\xf9\x89\xc6\x25\x1b\x29\xbf\x38\xd3\x9a\x9b\xdc\xe7\xc5\x5f\x4b\x2a\xc1\x2a\x39",
    ),
  )
}

///|
test "Salsa20: encrypt (enc_32)" {
  let ct = salsa20_xor(
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x00\x00\x00\x00\x00\x00\x00\x00", 0, b"\x54\x68\x65\x20\x71\x75\x69\x63\x6b\x20\x62\x72\x6f\x77\x6e\x20\x66\x6f\x78\x20\x6a\x75\x6d\x70\x73\x20\x6f\x76\x65\x72\x20\x74\x68\x65\x20\x6c\x61\x7a\x79\x20\x64\x6f\x67",
  )
  assert_true(
    bytes_equal(
      ct, b"\xce\xff\x93\x7b\xea\x39\x1b\x78\xfd\x2a\x05\x53\x2a\x8b\xc6\xf4\x85\x41\x1f\xd9\x7b\x6b\xc4\x09\xbd\xbc\x27\x50\xe5\x18\xce\x92\x55\x8c\xe0\xb6\x4a\xad\x80\x3e\xd8\xdd\x04",
    ),
  )
}

///|
test "Salsa20: encrypt (enc_32_rand)" {
  let ct = salsa20_xor(
    b"\xe2\x9a\xd6\xa4\xe4\x67\x86\xf6\x64\x81\xec\xe8\x77\xc0\x61\x60\x0d\x45\x26\x98\xd9\xff\xf4\x3b\x60\xc5\xb5\xcb\xf2\x8b\x90\xd5",
    b"\x4c\x77\x47\x5e\x9a\xa5\xf2\x25", 0, b"\x73\x65\x63\x72\x65\x74\x20\x73\x61\x6c\x73\x61\x20\x6d\x65\x73\x73\x61\x67\x65\x20\x68\x65\x72\x65",
  )
  assert_true(
    bytes_equal(
      ct, b"\x05\xa4\x33\x9d\x07\x90\xa9\xbb\x0e\xf4\x4f\x68\x96\x73\x71\x6f\x7f\xb5\x0d\xc7\x8a\xdd\x7b\xf9\xb0",
    ),
  )
}

///|
test "Salsa20: encrypt (enc_16)" {
  let ct = salsa20_xor(
    b"\xbe\x5b\x5e\x4a\xad\x7e\xf0\xbb\xd7\xee\x49\x27\xd9\xa1\x2d\x75", b"\x75\x7e\x3f\x81\xaa\x42\xbf\x30",
    0, b"\x31\x36\x2d\x62\x79\x74\x65\x20\x6b\x65\x79\x20\x73\x61\x6c\x73\x61\x20\x74\x65\x73\x74",
  )
  assert_true(
    bytes_equal(
      ct, b"\x7a\x44\x96\x0a\xee\x2e\x33\x77\x39\x20\x16\x5b\x70\xa8\x89\x22\x77\x85\x50\x0b\x21\xbe",
    ),
  )
}

///|
test "Salsa20: encrypt (enc_multi)" {
  let ct = salsa20_xor(
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x00\x00\x00\x00\x00\x00\x00\x00", 0, b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7",
  )
  assert_true(
    bytes_equal(
      ct, b"\x9a\x96\xf4\x58\x9f\x49\x74\x1c\x9e\x03\x6d\x2a\x49\xf1\xa6\xdb\xf3\x3f\x75\xea\x05\x0b\xbf\x6e\xd6\x85\x52\x3d\x9c\x77\xf0\xf9\x1d\xc8\xe2\xf9\x0f\xf2\xdf\x39\x94\x9b\x49\xb0\xd5\xa4\xe8\x0a\x2b\x18\x8d\x0b\xe7\xaf\xad\xeb\xdf\xfc\x65\x70\x16\xfc\x14\x06\xeb\xab\xc8\x54\x20\x28\x5c\x30\xca\xbd\xb8\xe5\x12\xd2\x65\x91\xfc\x43\x13\x15\x5f\xfd\x5d\x82\xe6\xb6\xe5\xdc\xc8\xc5\xd6\x6b\xa4\xb8\x29\xd5\xad\x76\x2b\x36\x4e\x0d\xa3\x66\xbc\x81\xd5\x4e\xfd\x2b\x56\x8c\x8f\x1c\xb8\xc3\x57\x27\x80\xce\xf8\xc3\x10\x6f\x8b\x26\x53\x17\xc7\xf0\xa7\xbb\x62\xa5\x5d\x19\x84\xe9\xab\x8d\x8e\x02\x08\x34\xa6\xa6\x55\x47\x7e\x9f\x7a\x57\xe5\x09\xaf\x8c\xf3\xf3\x4a\x7d\x04\xa3\x12\xef\x5c\xb1\xf8\x2d\xcb\xef\xf3\x87\x10\x54\x96\x48\xec\x9b\x82\x0e\xb8\x15\x5a\xe3\x8a\x18\x04\x35\xef\xfd\xfc\xd3\xa0\x54\xa6\x73",
    ),
  )
}

///|
test "Salsa20: round-trip (encrypt then decrypt)" {
  let key = b"\xe2\x9a\xd6\xa4\xe4\x67\x86\xf6\x64\x81\xec\xe8\x77\xc0\x61\x60\x0d\x45\x26\x98\xd9\xff\xf4\x3b\x60\xc5\xb5\xcb\xf2\x8b\x90\xd5"
  let nonce = b"\x4c\x77\x47\x5e\x9a\xa5\xf2\x25"
  let pt = b"symmetric stream cipher round trip"
  let ct = salsa20_xor(key, nonce, 0, pt)
  let rec = salsa20_xor(key, nonce, 0, ct)
  assert_true(bytes_equal(rec, pt))
}
