  let c : Array[Double] = []
  for i = 0; i < 512; i = i + 1 {
    c.push(fp_of(i * 53 % 251 - 125))
  }
  falcon_fft(c, 9)
  let d0 = Array::make(256, 0.0)
  let d1 = Array::make(256, 0.0)
  falcon_poly_split_fft(d0, d1, c, 9)
  falcon_poly_merge_fft(c, d0, d1, 9)
  inspect(m2_bits_eq(c, exp), content="true")
}

///|
test "falcon-m2-constants-roundtrip" {
  // The C scalar constants survive the u64->f64->u64 trip through our
  // planned Double representation (sanity for M4/M5 constant handling).
  let csig_inv : Array[UInt64] = [
    0UL, 4574611497772390042UL, 4574501679055810265UL, 4574396282908341804UL, 4574245855758572086UL,
    4574103865040221165UL, 4573969550563515544UL, 4573842244705920822UL, 4573721358406441454UL,
    4573606369665796042UL, 4573496814039276259UL,
  ]
  let csig_min : Array[UInt64] = [
    0UL, 4607707126469777035UL, 4607777455861499430UL, 4607846828256951418UL, 4607949175006100261UL,
    4608049571757433526UL, 4608148125896792003UL, 4608244935301382692UL, 4608340089478362016UL,
    4608433670533905013UL, 4608525754002622308UL,
  ]
  let cconsts : Array[UInt64] = [
    4667981563525332992UL, 4545632735260551042UL, 4594603506513722306UL, 4604418534313441775UL,
    4609176140021203710UL, 4670353323383631276UL,
  ]
  let mut ok = true
  for v in csig_inv {
    if v.reinterpret_as_double().reinterpret_as_uint64() != v {
      ok = false
    }
  }
  for v in csig_min {
    if v.reinterpret_as_double().reinterpret_as_uint64() != v {
      ok = false
    }
  }
  for v in cconsts {
    if v.reinterpret_as_double().reinterpret_as_uint64() != v {
      ok = false
    }
  }
  inspect(ok, content="true")
}
