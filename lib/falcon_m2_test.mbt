// Falcon M2 tests: FFT/iFFT/poly ops vs bit-exact dumps from the
// official PQClean C reference (falcon_m2_vectors.txt).

///|
fn m2_bits_eq(a : Array[Double], exp : Array[UInt64]) -> Bool {
  if a.length() != exp.length() {
    return false
  }
  for i = 0; i < a.length(); i = i + 1 {
    if a[i].reinterpret_as_uint64() != exp[i] {
      return false
    }
  }
  true
}

///|
fn m2_pattern(len : Int) -> Array[Double] {
  let f : Array[Double] = []
  for i = 0; i < len; i = i + 1 {
    f.push(fp_of(i * 37 % 251 - 125))
  }
  f
}

