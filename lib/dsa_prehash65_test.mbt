test "HashML-DSA-65 sigGen preHash SHA3-224 tr1 #82" {
  let (_, sk) = ml_dsa_65_keygen(
    hex_to_bytes(
      "93B158735E77CC93B43BBE0DE7DB96C28CBA61BC25B5E0B0CD7DD51A9CF0E384",
    ),
  )
  let msg = hex_to_bytes(
    "FFB7C5CCC7FE2D4E069C4FCC9D055933E01D5823DEB15B654516CC6DB6631CED77018281295D7C43" +
    "E0766DC525585F75FF27D1421943CC8238EE2944410EC573617424FD7A595BB1607266AA3393546F" +
    "5A0E7C7CD77E629CFFFDDA840FDDB54721A05979C7B9837CA4A8C17CDFCB7F12733822F755E714BB" +
