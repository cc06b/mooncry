///|
test "HashML-DSA-65 sigGen preHash SHA3-384 tr1 #77" {
  let (_, sk) = ml_dsa_65_keygen(
    hex_to_bytes(
      "3FA1E68730A816BA822170FF493CEA6D98BFE4CA3DEF32FBCDA638B0AB5306B8",
    ),
  )
  let msg = hex_to_bytes("77")
  let ctx = hex_to_bytes(
    "0F937193FC0B003F1C434253D6448DE06CAD256FB272EAE8F9CF476317B5D14F50A0758151264536" +
    "FFDB75551607278245D95A310B79A28514C3BA4241001B9199585AFEC7D2BAC6DE30E955F7FFABB3" +
    "11886332476AA8AA9E3C530BED2466E8306C55C2BA390BA90CA19BB42441C168CEA866A7E84BFEEE" +
    "1A1537D27BC6687AE40E96B9677A5C77304C7E4658C3C0D50ECFD2569E4BF6C726BC3C17B03BF58A" +
    "E8F477E417D037A1FF04F3DF1225AA572CE70D7151506F5CF2AD8A9F1C5B7C232B916B021AECBD1C" +
    "4024A70DA7E974B05B59722C5F201C53F791D1D4ED78C6A6129BC887D605B09F146C916DA466EDC4" +
    "827717E2028EBFF4194108CA8CD189",
  )
  let rnd = Bytes::make(32, b'␀')
  let sig = ml_dsa_65_sign_prehash(sk, msg, rnd, ctx, dsa_prehash_sha3_384)
  assert_true(
    bytes_equal(
      sig,
      hex_to_bytes(
        "D24990C5F713F2C4C946740499A356286A497435E1E94BABFFF70C7F290F6EC518D22D44D92B3427" +
        "A2D85450141E822C8D5F30F43B76AA46CAC6B3C3CF88FCB47DAA00E2BE3DC8975469B298C7D2970C" +
        "795AE7EB12EC210A348FE40E85AF3FB0CC4CCBA0A29371E57B3F09FB7DF0AE2EF326F5D63D41ECEB" +
