///|
test "ML-KEM hybrid round-trips (empty / exact blocks / awkward sizes)" {
  // deterministic key material derived from constants
  let d = Bytes::make(32, b'\x42')
  let z = Bytes::make(32, b'\x24')
  let m = Bytes::make(32, b'\x66')
  let aad = b"round-trip aad"
  let (ek, dk) = ml_kem_768_keygen(d, z)
  let msgs : Array[Bytes] = [
    b"",
    Bytes::make(64, b'A'),
    Bytes::make(128, b'B'),
    Bytes::make(63, b'C'),
    Bytes::make(65, b'D'),
    Bytes::make(1000, b'E'),
  ]
  for msg in msgs {
    let blob = ml_kem_768_hybrid_seal(ek, m, aad, msg)
    match ml_kem_768_hybrid_open(dk, blob, aad) {
      Some(pt) => assert_true(bytes_equal(pt, msg))
      None => assert_true(false)
    }
  }
}

///|
test "ML-KEM hybrid rejects tampering and truncation" {
  let d = Bytes::make(32, b'\x42')
  let z = Bytes::make(32, b'\x24')
  let m = Bytes::make(32, b'\x66')
  let aad = b"tamper aad"
  let (ek, dk) = ml_kem_768_keygen(d, z)
  let msg = Bytes::make(300, b'X')
  let blob = ml_kem_768_hybrid_seal(ek, m, aad, msg)
  // flip one ciphertext byte
  let arr1 = blob.to_array()
  arr1[1200] = arr1[1200] ^ b'\x01'
  let bad1 = Bytes::from_array(arr1)
  assert_true(ml_kem_768_hybrid_open(dk, bad1, aad) == None)
  // flip one byte inside the KEM part
  let arr2 = blob.to_array()
  arr2[10] = arr2[10] ^ b'\x80'
  let bad2 = Bytes::from_array(arr2)
  assert_true(ml_kem_768_hybrid_open(dk, bad2, aad) == None)
  // wrong aad
  assert_true(ml_kem_768_hybrid_open(dk, blob, b"other aad") == None)
  // truncated blob
  let short = Bytes::from_array(blob.to_array()[:500])
  assert_true(ml_kem_768_hybrid_open(dk, short, aad) == None)
  // wrong key
  let (_, dk2) = ml_kem_768_keygen(
    Bytes::make(32, b'\x11'),
    Bytes::make(32, b'\x22'),
  )
  assert_true(ml_kem_768_hybrid_open(dk2, blob, aad) == None)
}

///|
test "ML-KEM hybrid streaming equals one-shot (awkward chunking)" {
  let d = Bytes::make(32, b'\x42')
  let z = Bytes::make(32, b'\x24')
  let m = Bytes::make(32, b'\x66')
  let aad = b"stream aad"
  let (ek, dk) = ml_kem_768_keygen(d, z)
  let msg = Bytes::make(777, b'S')
  let one_shot = ml_kem_768_hybrid_seal(ek, m, aad, msg)
  let (c, st) = ml_kem_768_hybrid_seal_init(ek, m, aad)
  let sizes : Array[Int] = [1, 63, 64, 65, 500, 84]
  let parts : Array[Bytes] = [c]
  let mut off = 0
  for sz in sizes {
    let take = if off + sz > msg.length() { msg.length() - off } else { sz }
    if take > 0 {
      let chunk = Bytes::from_array(msg.to_array()[off:off + take])
      parts.push(ml_kem_hybrid_stream_update(st, chunk))
      off = off + take
    }
  }
  parts.push(ml_kem_hybrid_stream_final(st))
  let mut streamed = b""
  for part in parts {
    streamed = streamed + part
  }
  assert_true(bytes_equal(streamed, one_shot))
  match ml_kem_768_hybrid_open(dk, streamed, aad) {
    Some(pt) => assert_true(bytes_equal(pt, msg))
    None => assert_true(false)
  }
}

///|
test "ML-KEM 512/1024 hybrid round-trips" {
  let d = Bytes::make(32, b'\x31')
  let z = Bytes::make(32, b'\x13')
  let m = Bytes::make(32, b'\x55')
  let aad = b""
  let msg = Bytes::make(500, b'Q')
  let (ek5, dk5) = ml_kem_512_keygen(d, z)
  let b5 = ml_kem_512_hybrid_seal(ek5, m, aad, msg)
  match ml_kem_512_hybrid_open(dk5, b5, aad) {
    Some(pt) => assert_true(bytes_equal(pt, msg))
    None => assert_true(false)
  }
  let (ek10, dk10) = ml_kem_1024_keygen(d, z)
  let b10 = ml_kem_1024_hybrid_seal(ek10, m, aad, msg)
  match ml_kem_1024_hybrid_open(dk10, b10, aad) {
    Some(pt) => assert_true(bytes_equal(pt, msg))
    None => assert_true(false)
  }
}
