// ==================== Ed25519 (RFC 8032) ====================
// Vectors cross-checked against the `cryptography` library (Ed25519).
// Signing is deterministic, so signatures are byte-exact.

///|
let ed_test_seed : Bytes = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"

///|
let ed_test_pk : Bytes = b"\x03\xa1\x07\xbf\xf3\xce\x10\xbe\x1d\x70\xdd\x18\xe7\x4b\xc0\x99\x67\xe4\xd6\x30\x9b\xa5\x0d\x5f\x1d\xdc\x86\x64\x12\x55\x31\xb8"

///|
test "Ed25519: public key from seed" {
  assert_true(bytes_equal(ed25519_public_key(ed_test_seed), ed_test_pk))
}

///|
test "Ed25519: sign msg#0 (0B) exact" {
  let sig = ed25519_sign(ed_test_seed, b"")
  assert_true(
    bytes_equal(
      sig, b"\x9c\xa5\x35\x79\x53\x06\x54\xd5\xc3\xdf\x77\x08\x9e\xf4\x5e\xda\x61\x3e\x2f\xed\xf6\x70\xe9\x6b\xed\xac\x46\x39\x50\x4e\x58\x45\xef\x4b\x95\xd5\x79\x30\x77\x23\x3d\xd1\x68\x17\xb2\x53\x2e\x9c\x55\x25\x87\x2a\x73\xa4\xad\x74\xb7\x59\x36\x9a\x9e\x05\xc1\x02",
    ),
  )
}

///|
test "Ed25519: verify msg#0" {
  assert_true(
    ed25519_verify(
      ed_test_pk, b"", b"\x9c\xa5\x35\x79\x53\x06\x54\xd5\xc3\xdf\x77\x08\x9e\xf4\x5e\xda\x61\x3e\x2f\xed\xf6\x70\xe9\x6b\xed\xac\x46\x39\x50\x4e\x58\x45\xef\x4b\x95\xd5\x79\x30\x77\x23\x3d\xd1\x68\x17\xb2\x53\x2e\x9c\x55\x25\x87\x2a\x73\xa4\xad\x74\xb7\x59\x36\x9a\x9e\x05\xc1\x02",
    ),
  )
}

///|
test "Ed25519: sign msg#1 (3B) exact" {
  let sig = ed25519_sign(ed_test_seed, b"\x61\x62\x63")
  assert_true(
    bytes_equal(
      sig, b"\xcc\x46\xd6\x2d\x37\x54\xf4\x17\x54\xb2\x7b\x6e\xa2\xcb\x2c\x27\x2b\xaf\xa7\xa5\xa1\xf6\x06\x2b\xd0\x60\xf4\x14\xe5\x0c\xaa\xea\xc2\xda\x66\xad\x39\xce\xf4\x42\x4a\x90\x23\x6e\xa9\x07\xb7\xd8\x05\x7e\x34\x43\xdc\x5a\xbf\xc9\x98\x69\x67\xee\x72\x13\xa4\x07",
    ),
  )
}

///|
test "Ed25519: verify msg#1" {
  assert_true(
    ed25519_verify(
      ed_test_pk, b"\x61\x62\x63", b"\xcc\x46\xd6\x2d\x37\x54\xf4\x17\x54\xb2\x7b\x6e\xa2\xcb\x2c\x27\x2b\xaf\xa7\xa5\xa1\xf6\x06\x2b\xd0\x60\xf4\x14\xe5\x0c\xaa\xea\xc2\xda\x66\xad\x39\xce\xf4\x42\x4a\x90\x23\x6e\xa9\x07\xb7\xd8\x05\x7e\x34\x43\xdc\x5a\xbf\xc9\x98\x69\x67\xee\x72\x13\xa4\x07",
    ),
  )
}

///|
test "Ed25519: sign msg#2 (15B) exact" {
  let sig = ed25519_sign(
    ed_test_seed, b"\x6d\x65\x73\x73\x61\x67\x65\x20\x74\x6f\x20\x73\x69\x67\x6e",
  )
  assert_true(
    bytes_equal(
      sig, b"\x2a\xab\x11\xbd\x79\x21\x51\x04\xd4\x2b\xae\x74\x88\x20\xcc\xca\x8b\x32\xe9\x9f\xd6\x1a\x58\x8e\x17\x01\xb6\xc6\x5a\x40\x53\xc3\x88\xea\xf0\xb0\x1f\x4b\xe3\x5d\x52\x52\xc8\x96\x9a\x55\x96\xa1\x9e\x0f\x05\xdb\x1f\xdc\x02\x0a\xb6\xf6\xd9\xae\xf6\xcd\xf6\x08",
    ),
  )
}

///|
test "Ed25519: verify msg#2" {
  assert_true(
    ed25519_verify(
      ed_test_pk, b"\x6d\x65\x73\x73\x61\x67\x65\x20\x74\x6f\x20\x73\x69\x67\x6e",
      b"\x2a\xab\x11\xbd\x79\x21\x51\x04\xd4\x2b\xae\x74\x88\x20\xcc\xca\x8b\x32\xe9\x9f\xd6\x1a\x58\x8e\x17\x01\xb6\xc6\x5a\x40\x53\xc3\x88\xea\xf0\xb0\x1f\x4b\xe3\x5d\x52\x52\xc8\x96\x9a\x55\x96\xa1\x9e\x0f\x05\xdb\x1f\xdc\x02\x0a\xb6\xf6\xd9\xae\xf6\xcd\xf6\x08",
    ),
  )
}

///|
test "Ed25519: sign msg#3 (19B) exact" {
  let sig = ed25519_sign(
    ed_test_seed, b"\x54\x68\x65\x20\x71\x75\x69\x63\x6b\x20\x62\x72\x6f\x77\x6e\x20\x66\x6f\x78",
  )
  assert_true(
    bytes_equal(
      sig, b"\xca\x64\xbc\xcd\x52\x5c\x95\x94\xe7\x60\x86\x70\x14\x06\xb8\x70\x4b\xc5\xff\x25\xfb\x57\x29\x17\x6b\x42\x0f\x49\x91\xa2\x53\x2d\x7e\x7e\x38\x0f\xfc\x53\x14\xeb\x1d\x11\x82\x9e\x68\x37\x8f\x78\x03\x50\x16\xc9\x3d\x5f\x55\xd7\xfb\x28\x0b\x3a\x74\xf1\x38\x00",
    ),
  )
}

///|
test "Ed25519: verify msg#3" {
  assert_true(
    ed25519_verify(
      ed_test_pk, b"\x54\x68\x65\x20\x71\x75\x69\x63\x6b\x20\x62\x72\x6f\x77\x6e\x20\x66\x6f\x78",
      b"\xca\x64\xbc\xcd\x52\x5c\x95\x94\xe7\x60\x86\x70\x14\x06\xb8\x70\x4b\xc5\xff\x25\xfb\x57\x29\x17\x6b\x42\x0f\x49\x91\xa2\x53\x2d\x7e\x7e\x38\x0f\xfc\x53\x14\xeb\x1d\x11\x82\x9e\x68\x37\x8f\x78\x03\x50\x16\xc9\x3d\x5f\x55\xd7\xfb\x28\x0b\x3a\x74\xf1\x38\x00",
    ),
  )
}

///|
test "Ed25519: reject tampered message" {
  let sig = b"\xcc\x46\xd6\x2d\x37\x54\xf4\x17\x54\xb2\x7b\x6e\xa2\xcb\x2c\x27\x2b\xaf\xa7\xa5\xa1\xf6\x06\x2b\xd0\x60\xf4\x14\xe5\x0c\xaa\xea\xc2\xda\x66\xad\x39\xce\xf4\x42\x4a\x90\x23\x6e\xa9\x07\xb7\xd8\x05\x7e\x34\x43\xdc\x5a\xbf\xc9\x98\x69\x67\xee\x72\x13\xa4\x07"
  assert_true(!ed25519_verify(ed_test_pk, b"wrong message", sig))
}

///|
test "Ed25519: reject tampered signature" {
  let msg = b"\x61\x62\x63"
  let sig = b"\xcc\x46\xd6\x2d\x37\x54\xf4\x17\x54\xb2\x7b\x6e\xa2\xcb\x2c\x27\x2b\xaf\xa7\xa5\xa1\xf6\x06\x2b\xd0\x60\xf4\x14\xe5\x0c\xaa\xea\xc2\xda\x66\xad\x39\xce\xf4\x42\x4a\x90\x23\x6e\xa9\x07\xb7\xd8\x05\x7e\x34\x43\xdc\x5a\xbf\xc9\x98\x69\x67\xee\x72\x13\xa4\x07"
  let bad_arr = Array::make(64, b'\x00')
  for i in 0..<64 {
    bad_arr[i] = sig[i]
  }
  bad_arr[0] = (bad_arr[0].to_int() ^ 0x01).to_byte()
  let bad = Bytes::from_array(bad_arr[:])
  assert_true(!ed25519_verify(ed_test_pk, msg, bad))
}
