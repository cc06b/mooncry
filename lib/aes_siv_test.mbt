    Ok(pt) =>
      assert_true(
        bytes_equal(
          pt, b"\x6d\x75\x6c\x74\x69\x70\x6c\x65\x20\x61\x73\x73\x6f\x63\x69\x61\x74\x65\x64\x20\x64\x61\x74\x61\x20\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x73",
