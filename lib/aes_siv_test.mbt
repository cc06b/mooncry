  match
    aes_siv_decrypt(
      b"\x4e\x66\x32\x6c\x33\x1b\xce\xb5\x84\x11\xd2\x5d\x72\xad\x9f\xd2\xc9\x0d\xa9\x00\xc4\xae\x62\x0d\xb3\x60\x76\xca\x13\xa2\x2b\xc5\xac\x22\x1a\xa4\xfc\x12\xdb\x12\x7f\xb2\x2a\x03\x4f\xb7\x82\xa5\x27\x39\x3d\x96\xf9\x5c\xfa\x2a\x39\xc3\x38",
      b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
      [b"\x61\x61\x64\x20\x68\x65\x72\x65"],
