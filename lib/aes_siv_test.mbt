///|
test "AES-SIV encrypt: 256 2AD" {
  let env = aes_siv_encrypt(
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f",
    b"\x6d\x75\x6c\x74\x69\x70\x6c\x65\x20\x61\x73\x73\x6f\x63\x69\x61\x74\x65\x64\x20\x64\x61\x74\x61\x20\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x73",
    [b"\x61\x64\x31", b"\x61\x64\x32\x64\x61\x74\x61"],
  )
  assert_true(
    bytes_equal(
      env, b"\xd0\xdf\x2a\x6b\x74\xd4\xe8\xf3\x57\x78\x74\xc4\xab\xf4\xc5\x9a\x00\x57\xd7\x64\x34\x63\x43\x55\xf7\x6c\xec\x41\x6f\xeb\xe5\x3c\x9f\x5e\x44\xb3\xf8\xa2\x05\x75\x5c\xec\xd4\x69\x92\x90\x25\xf0\x7b\xc0\x13",
    ),
  )
}

///|
test "AES-SIV decrypt: 256 2AD" {
  match
    aes_siv_decrypt(
      b"\xd0\xdf\x2a\x6b\x74\xd4\xe8\xf3\x57\x78\x74\xc4\xab\xf4\xc5\x9a\x00\x57\xd7\x64\x34\x63\x43\x55\xf7\x6c\xec\x41\x6f\xeb\xe5\x3c\x9f\x5e\x44\xb3\xf8\xa2\x05\x75\x5c\xec\xd4\x69\x92\x90\x25\xf0\x7b\xc0\x13",
