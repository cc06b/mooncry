///|
test "AES-SIV rejects tampered tag" {
  let env = b"\x8b\xa3\x57\xe6\xf9\x00\xae\x88\x78\xb9\xc7\x0c\x07\xa6\x15\x4d\xc3\xaa\x3d\x94\xbf\x9f\x3d\xd9\xe3\x03\x01\x74\x20\x18\xa4\xbe\x84\xaa\xbb\xa1\x98"
  let bad_arr = Array::make(env.length(), b'\x00')
  for i in 0..<env.length() {
    bad_arr[i] = env[i]
  }
  bad_arr[0] = (bad_arr[0].to_int() ^ 0x01).to_byte()
  match
    aes_siv_decrypt(
      Bytes::from_array(bad_arr[:]),
      b"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
      [b"aad here"],
    ) {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}
