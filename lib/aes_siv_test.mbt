// ==================== AES-SIV (RFC 5297) ====================
// Vectors cross-checked against pycryptodome AES.MODE_SIV (no nonce; AD via update).
// Wire format: IV(16) || ciphertext.

///|
test "AES-SIV encrypt: 128 noAD short" {
  let env = aes_siv_encrypt(
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
    b"\x73\x68\x6f\x72\x74\x20\x70\x74",
    [],
  )
  assert_true(
    bytes_equal(
      env, b"\x35\xe1\xe4\x44\x44\x3d\x3d\x49\xf1\x02\xe7\xf1\x47\x90\x66\x5a\x4a\xf0\x4c\x70\x6f\xa2\x7f\x08",
    ),
  )
}

///|
test "AES-SIV decrypt: 128 noAD short" {
  match
    aes_siv_decrypt(
      b"\x35\xe1\xe4\x44\x44\x3d\x3d\x49\xf1\x02\xe7\xf1\x47\x90\x66\x5a\x4a\xf0\x4c\x70\x6f\xa2\x7f\x08",
      b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
      [],
    ) {
    Ok(pt) => assert_true(bytes_equal(pt, b"\x73\x68\x6f\x72\x74\x20\x70\x74"))
    Err(_) => assert_true(false)
  }
}

///|
test "AES-SIV encrypt: 128 1AD" {
  let env = aes_siv_encrypt(
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
    b"\x61\x20\x6c\x6f\x6e\x67\x65\x72\x20\x70\x6c\x61\x69\x6e\x74\x65\x78\x74\x20\x74\x6f\x20\x65\x6e\x63\x72\x79\x70\x74\x20\x77\x69\x74\x68\x20\x73\x69\x76\x20\x6d\x6f\x64\x65",
    [b"\x61\x61\x64\x20\x68\x65\x72\x65"],
  )
