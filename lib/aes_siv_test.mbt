          pt, b"\x61\x20\x6c\x6f\x6e\x67\x65\x72\x20\x70\x6c\x61\x69\x6e\x74\x65\x78\x74\x20\x74\x6f\x20\x65\x6e\x63\x72\x79\x70\x74\x20\x77\x69\x74\x68\x20\x73\x69\x76\x20\x6d\x6f\x64\x65",
