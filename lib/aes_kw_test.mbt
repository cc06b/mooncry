// ==================== AES Key Wrap (RFC 3397) ====================
// Vectors cross-checked against a Python RFC 3397 reference (pycryptodome AES-ECB).

///|
test "AES-KW wrap: case 0 (kek=16B data=16B)" {
  assert_true(
    bytes_equal(
      aes_kw_wrap(
        b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f", b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff",
      ),
      b"\x1f\xa6\x8b\x0a\x81\x12\xb4\x47\xae\xf3\x4b\xd8\xfb\x5a\x7b\x82\x9d\x3e\x86\x23\x71\xd2\xcf\xe5",
    ),
  )
}

///|
test "AES-KW unwrap: case 0" {
  match
    aes_kw_unwrap(
      b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f", b"\x1f\xa6\x8b\x0a\x81\x12\xb4\x47\xae\xf3\x4b\xd8\xfb\x5a\x7b\x82\x9d\x3e\x86\x23\x71\xd2\xcf\xe5",
    ) {
    Ok(d) =>
      assert_true(
        bytes_equal(
          d, b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff",
        ),
      )
    Err(_) => assert_true(false)
  }
}

///|
test "AES-KW wrap: case 1 (kek=16B data=24B)" {
  assert_true(
    bytes_equal(
      aes_kw_wrap(
        b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f", b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff\x00\x11\x22\x33\x44\x55\x66\x77",
      ),
      b"\x47\xa5\x10\x1b\xea\x68\xc9\xc0\x50\x43\xf5\xa0\x72\xc4\x51\xe7\x16\x23\x8c\x41\xc4\x27\xe3\x0d\x0e\x31\x5c\x27\x7c\x2e\x4c\xd7",
    ),
  )
}

///|
test "AES-KW unwrap: case 1" {
  match
    aes_kw_unwrap(
      b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f", b"\x47\xa5\x10\x1b\xea\x68\xc9\xc0\x50\x43\xf5\xa0\x72\xc4\x51\xe7\x16\x23\x8c\x41\xc4\x27\xe3\x0d\x0e\x31\x5c\x27\x7c\x2e\x4c\xd7",
    ) {
    Ok(d) =>
      assert_true(
        bytes_equal(
          d, b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff\x00\x11\x22\x33\x44\x55\x66\x77",
        ),
      )
    Err(_) => assert_true(false)
  }
}

///|
test "AES-KW wrap: case 2 (kek=24B data=16B)" {
  assert_true(
    bytes_equal(
      aes_kw_wrap(
        b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17",
        b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff",
      ),
      b"\x96\x77\x8b\x25\xae\x6c\xa4\x35\xf9\x2b\x5b\x97\xc0\x50\xae\xd2\x46\x8a\xb8\xa1\x7a\xd8\x4e\x5d",
    ),
  )
}

///|
test "AES-KW unwrap: case 2" {
  match
    aes_kw_unwrap(
      b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17",
      b"\x96\x77\x8b\x25\xae\x6c\xa4\x35\xf9\x2b\x5b\x97\xc0\x50\xae\xd2\x46\x8a\xb8\xa1\x7a\xd8\x4e\x5d",
    ) {
    Ok(d) =>
      assert_true(
        bytes_equal(
          d, b"\x00\x11\x22\x33\x44\x55\x66\x77\x88\x99\xaa\xbb\xcc\xdd\xee\xff",
        ),
      )
    Err(_) => assert_true(false)
  }
}

///|
test "AES-KW wrap: case 3 (kek=32B data=32B)" {
  assert_true(
    bytes_equal(
      aes_kw_wrap(
        b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
        b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
      ),
      b"\x82\xc6\x93\xbf\xf4\x87\xdb\x7c\x31\xa7\xf0\xcc\x44\x0a\xd9\xe3\x77\x09\x51\x1b\x52\xef\xce\x48\x09\x4b\x45\x48\xee\xe3\xcf\xc2\xbf\x78\x05\xb5\x12\x01\xbc\x01",
    ),
  )
}

///|
test "AES-KW unwrap: case 3" {
  match
    aes_kw_unwrap(
      b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
      b"\x82\xc6\x93\xbf\xf4\x87\xdb\x7c\x31\xa7\xf0\xcc\x44\x0a\xd9\xe3\x77\x09\x51\x1b\x52\xef\xce\x48\x09\x4b\x45\x48\xee\xe3\xcf\xc2\xbf\x78\x05\xb5\x12\x01\xbc\x01",
    ) {
    Ok(d) =>
      assert_true(
        bytes_equal(
          d, b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
        ),
      )
    Err(_) => assert_true(false)
  }
}

///|
test "AES-KW unwrap rejects tampered" {
  let kek = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f"
  let w = b"\x1f\xa6\x8b\x0a\x81\x12\xb4\x47\xae\xf3\x4b\xd8\xfb\x5a\x7b\x82\x9d\x3e\x86\x23\x71\xd2\xcf\xe5"
  let bad_arr = Array::make(w.length(), b'\x00')
  for i in 0..<w.length() {
    bad_arr[i] = w[i]
  }
  bad_arr[0] = (bad_arr[0].to_int() ^ 0x01).to_byte()
  match aes_kw_unwrap(kek, Bytes::from_array(bad_arr[:])) {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}
