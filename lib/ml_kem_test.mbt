///|
test "property: ML-KEM round-trip (keygen -> encaps -> decaps)" {
  let r = Rng::{ state: 0x2037C001U, }
  let d = rng_bytes(r, 32)
  let z = rng_bytes(r, 32)
  let m = rng_bytes(r, 32)
  let (ek, dk) = ml_kem_512_keygen(d, z)
  let (k1, c) = ml_kem_512_encaps(ek, m)
  let k2 = ml_kem_512_decaps(dk, c)
  assert_true(bytes_equal(k1, k2))
  // tampered ciphertext triggers implicit rejection: decaps returns
  // J(z || c') != k1
  let bad = Array::make(c.length(), b'␀')
  for i in 0..<c.length() {
    bad[i] = c[i]
  }
  bad[0] = (bad[0].to_int() ^ 1).to_byte()
  let k3 = ml_kem_512_decaps(dk, Bytes::from_array(bad[:]))
  assert_false(bytes_equal(k1, k3))
}
