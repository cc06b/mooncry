}

///|
test "falcon-1024-verify-second-key" {
  inspect(
    falcon1024_verify(f10_pk2(), f10_sig2b(), f10_msg_b(33)),
    content="true",
  )
}

///|
test "falcon-1024-keypair-byte-exact" {
  let r = falcon_test_rng_init()
  let seed = falcon_test_rng_bytes(r, 48)
  let (mypk, mysk) = falcon1024_keypair_from_seed(seed)
  inspect(mypk.length(), content="1793")
  inspect(mysk.length(), content="2305")
  inspect(bytes_equal(mypk, f10_pk()), content="true")
  inspect(bytes_equal(mysk, f10_sk()), content="true")
}

///|
fn f10_sign_with_ctr(t : Int, len : Int) -> Bytes {
  let r = falcon_test_rng_init()
  falcon_test_rng_set_ctr(r, (1 + 2 * t).to_uint64())
  let myrand = fn(k : Int) -> Bytes { falcon_test_rng_bytes(r, k) }
  falcon1024_sign(f10_sk(), f10_msg_a(t, len), myrand)
}

///|
test "falcon-1024-sign-sig0" {
  let got = f10_sign_with_ctr(0, 0)
  inspect(got.length(), content="1273")
  inspect(bytes_equal(got, f10_sig0()), content="true")
}

///|
test "falcon-1024-padded-acceptance" {
  // The padded verifier path at logn=10: compact official sig0 padded
  // with zeros to the fixed 1280-byte form must verify; 1281 must not.
  let sig = f10_sig0()
  let msg = f10_msg_a(0, 0)
  let padded = Array::make(1280, (0).to_byte())
  for i = 0; i < sig.length(); i = i + 1 {
    padded[i] = sig[i]
  }
  inspect(
    falcon1024_verify(f10_pk(), Bytes::from_array(padded), msg),
    content="true",
  )
  let too_long = Array::make(1281, (0).to_byte())
  for i = 0; i < 1280; i = i + 1 {
    too_long[i] = padded[i]
  }
  inspect(
    falcon1024_verify(f10_pk(), Bytes::from_array(too_long), msg),
    content="false",
  )
  // a nonzero byte in the padding region must fail
  let dirty = Array::make(1280, (0).to_byte())
  for i = 0; i < 1280; i = i + 1 {
    dirty[i] = padded[i]
  }
  dirty[1279] = (1).to_byte()
  inspect(
    falcon1024_verify(f10_pk(), Bytes::from_array(dirty), msg),
    content="false",
  )
}
