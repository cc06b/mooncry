///|
test "falcon-1024-verify-sig0" {
  inspect(
    falcon1024_verify(f10_pk(), f10_sig0(), f10_msg_a(0, 0)),
    content="true",
  )
  let cat : Array[Byte] = []
  let m = f10_msg_a(0, 0)
  for i = 0; i < m.length(); i = i + 1 {
    cat.push(m[i])
  }
  cat.push((0).to_byte())
  inspect(
    falcon1024_verify(f10_pk(), f10_sig0(), Bytes::from_array(cat)),
    content="false",
  )
}

///|
test "falcon-1024-verify-sig1" {
  inspect(
    falcon1024_verify(f10_pk(), f10_sig1(), f10_msg_a(1, 3)),
    content="true",
  )
  let cat : Array[Byte] = []
  let m = f10_msg_a(1, 3)
  for i = 0; i < m.length(); i = i + 1 {
    cat.push(m[i])
  }
  cat.push((0).to_byte())
  inspect(
    falcon1024_verify(f10_pk(), f10_sig1(), Bytes::from_array(cat)),
    content="false",
  )
}

///|
test "falcon-1024-verify-sig2" {
  inspect(
    falcon1024_verify(f10_pk(), f10_sig2(), f10_msg_a(2, 64)),
    content="true",
  )
  let cat : Array[Byte] = []
  let m = f10_msg_a(2, 64)
  for i = 0; i < m.length(); i = i + 1 {
    cat.push(m[i])
  }
  cat.push((0).to_byte())
  inspect(
    falcon1024_verify(f10_pk(), f10_sig2(), Bytes::from_array(cat)),
    content="false",
  )
}

///|
test "falcon-1024-verify-sig3" {
  inspect(
    falcon1024_verify(f10_pk(), f10_sig3(), f10_msg_a(3, 200)),
    content="true",
