// Falcon-1024 KATs: the official PQClean C reference vectors
// (falcon1024_vectors.txt, deterministic stub stream).

///|
fn f10_msg_a(t : Int, len : Int) -> Bytes {
  let a : Array[Byte] = []
  for i = 0; i < len; i = i + 1 {
    a.push(((i * 31 + t * 7) & 0xFF).to_byte())
  }
  Bytes::from_array(a)
}

///|
fn f10_msg_b(len : Int) -> Bytes {
  let a : Array[Byte] = []
  for i = 0; i < len; i = i + 1 {
    a.push(((255 - i) & 0xFF).to_byte())
  }
  Bytes::from_array(a)
}

