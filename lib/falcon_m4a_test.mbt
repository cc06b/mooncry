  let f = Array::make(512, 0)
  let g = Array::make(512, 0)
  for u = 0; u < 512; u = u + 1 {
    f[u] = u * 37 % 11 - 5
    g[u] = u * 53 % 13 - 6
  }
  let h = Array::make(512, 0)
  inspect(falcon_compute_public(h, f, g, 9), content="true")
  let mut ok = true
  for u = 0; u < 512; u = u + 1 {
    if h[u] != exp_h[u] {
      ok = false
    }
  }
  inspect(ok, content="true")
}

///|
test "falcon-m4a-mkgauss-stream" {
  let exp_g : Array[Int] = [
    -4, 3, 0, -4, -1, -1, -3, -9, -5, 1, -6, -1, 1, 6, 6, 0, -3, -6, -7, 1, -3, 2,
    9, 6, -1, 9, 4, -2, -2, 4, -5, -2, -1, -2, -3, 3, -4, 1, 4, 0, 6, -1, -5, 1,
    -4, 2, 2, -4, 0, 5, -1, -1, 3, -5, -3, 2, 3, -3, -4, -2, -4, -2, -7, -2,
  ]
  let seed = Array::make(48, (0).to_byte())
  for i = 0; i < 48; i = i + 1 {
    seed[i] = ((i * 7 + 3) & 0xFF).to_byte()
  }
  let x = falcon_xof_init()
  falcon_xof_inject(x, Bytes::from_array(seed))
  let _ = falcon_xof_extract(x, 0)
  let mut ok = true
  for t = 0; t < 64; t = t + 1 {
    if falcon_mkgauss(x, 9) != exp_g[t] {
      ok = false
    }
  }
  inspect(ok, content="true")
}
