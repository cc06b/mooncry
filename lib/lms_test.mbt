    "c1591849d4ed236338b147abde9f51ef9fd4e1c1",
  )
  let t0 = lms_keygen(6, 3, seed0, i0)
  assert_true(bytes_equal(lms_public_key(t0), lms_tslice(pk, 4, 56)))
  let t1 = lms_keygen(5, 4, seed1, i1)
  let sig0_len = 4 + (4 + 32 * 68) + 4 + 32 * 10
  let pk1 = lms_tslice(sig, 4 + sig0_len, 56)
  assert_true(bytes_equal(lms_public_key(t1), pk1))
}

