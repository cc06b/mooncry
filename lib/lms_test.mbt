///|
test "lms_roundtrip" {
  let seed = sha256(hex_to_bytes("6c6d7320726f756e6474726970"))
  let id = lms_tslice(seed, 0, 16)
  let sk = lms_keygen(5, 4, seed, id)
  let pk = lms_public_key(sk)
  let m1 = hex_to_bytes("6669727374206d657373616765")
  let m2 = hex_to_bytes("7365636f6e64206d657373616765")
  let s1 = lms_sign(sk, m1, None)
  let s2 = lms_sign(sk, m2, None)
  assert_true(lms_verify(pk, m1, s1))
  assert_true(lms_verify(pk, m2, s2))
  assert_false(lms_verify(pk, m2, s1))
  assert_false(lms_verify(pk, m1, s2))
}

///|
test "hss_roundtrip_l2" {
  let s0 = sha256(hex_to_bytes("687373206c6576656c2030"))
  let s1 = sha256(hex_to_bytes("687373206c6576656c2031"))
  let sk = hss_keygen([
    (5, 4, s0, lms_tslice(s0, 0, 16)),
    (5, 3, s1, lms_tslice(s1, 0, 16)),
  ])
  let pk = hss_public_key(sk)
  let msg = hex_to_bytes("687373206d657373616765")
  let sig = hss_sign(sk, msg, None)
  assert_true(hss_verify(pk, msg, sig))
  let bad = msg.to_array()
  bad[3] = (bad[3].to_int() ^ 0x40).to_byte()
  assert_false(hss_verify(pk, Bytes::from_array(bad), sig))
  let sig2 = hss_sign(sk, msg, None)
  assert_true(hss_verify(pk, msg, sig2))
}
