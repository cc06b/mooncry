/// LMS/HSS (RFC 8554) verification tests: Appendix F test cases +
/// oracle-generated vectors (W1-W8 x H5/H10/H15, HSS L=1/2/3).
///

///|
fn lms_tslice(b : Bytes, off : Int, len : Int) -> Bytes {
  let out = Array::make(len, b'\x00')
  for i in 0..<len {
    out[i] = b[off + i]
  }
  Bytes::from_array(out)
}

