  falcon_mq_intt(tt2, 9)
  for u = 0; u < 512; u = u + 1 {
    tt2[u] = mq_sub_pub(tt2[u], hm[u])
  }
  for u = 0; u < 512; u = u + 1 {
    let mut w = tt2[u]
    w = w - (12289 & (((12289 >> 1) - w) >> 31))
    tt2[u] = w
  }
  inspect(arr_eq_int(tt2, exp_ttf), content="true")
  inspect(falcon_is_short(tt2, s2, 9), content="true")
}

///|
fn arr_eq_int(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i = 0; i < a.length(); i = i + 1 {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

///|
fn mq_montymul_pub(x : Int, y : Int) -> Int {
  let z = x * y
  let w = ((z * 12287) & 0xFFFF) * 12289
  let mut zr = (z + w) >> 16
  zr = zr - 12289
  zr = zr + (12289 & (zr >> 31))
  zr
}

///|
fn mq_sub_pub(x : Int, y : Int) -> Int {
  let mut dd = x - y
  dd = dd + (12289 & (dd >> 31))
  dd
}

///|
fn m3_nonce0() -> Bytes {
  let s = m3_sig0()
  let a = Array::make(40, (0).to_byte())
  for i = 0; i < 40; i = i + 1 {
    a[i] = s[1 + i]
  }
  Bytes::from_array(a)
}
