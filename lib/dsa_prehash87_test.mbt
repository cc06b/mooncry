///|
test "HashML-DSA-87 sigGen preHash SHA2-224 tr1 #141" {
  let { sk, .. } = ml_dsa_87_keygen(
    hex_to_bytes(
      "9FB68C7B55B9074B222AEE0BF9B515546E2EFD4CAE410BE47464235733AC8920",
    ),
  )
  let msg = hex_to_bytes("51")
  let ctx = b""
  let rnd = Bytes::make(32, b'\x00')
  let sig = ml_dsa_87_sign_prehash(sk, msg, rnd, ctx, dsa_prehash_sha2_224)
  assert_true(
    bytes_equal(
      sig,
      hex_to_bytes(
        "A723063E2A13FB4B9BA3883C8EE4CB303275655679F473A8C8B71BB8574E6D233E1F41CF42C7500A" +
