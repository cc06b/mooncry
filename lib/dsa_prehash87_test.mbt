    hex_to_bytes(
      "A52F55C2ADEB340108AC9B6BC2B56B6AD7BF0AA8E42C504917A6C9D170187E9E",
    ),
  )
  let msg = hex_to_bytes(
    "3C5AA4907776393FF68E5E5774D84668AC264FA2408FA1FBDB3ABE40C01B8BBDEA24DB7856EFB4EF" +
    "24415B69369868A5120BDA0B0C787F17D2FB802B655D8152F894EFDD7D587486315C1AC0A774F75B" +
