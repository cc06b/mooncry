///|
test "TOTP RFC 6238: T=59" {
  assert_true(
    totp(
      b"\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30",
      59UL, 30, 8,
    ) ==
    "94287082",
  )
}

///|
test "TOTP RFC 6238: T=1111111109" {
  assert_true(
    totp(
      b"\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30",
      1111111109UL, 30, 8,
    ) ==
    "07081804",
  )
}

