// ==================== SHA-1 + HMAC-SHA1 + HOTP + TOTP ====================
// Vectors: SHA-1 vs hashlib.sha1, HMAC-SHA1 vs Python hmac, HOTP vs RFC 4226, TOTP vs RFC 6238.

///|
test "SHA-1: empty" {
  assert_true(
    bytes_equal(
      sha1(b""),
      hex_to_bytes("da39a3ee5e6b4b0d3255bfef95601890afd80709"),
    ),
  )
}

///|
test "SHA-1: abc" {
  assert_true(
    bytes_equal(
      sha1(b"\x61\x62\x63"),
      hex_to_bytes("a9993e364706816aba3e25717850c26c9cd0d89d"),
    ),
  )
}

///|
test "SHA-1: fox" {
  assert_true(
    bytes_equal(
      sha1(
        b"\x54\x68\x65\x20\x71\x75\x69\x63\x6b\x20\x62\x72\x6f\x77\x6e\x20\x66\x6f\x78\x20\x6a\x75\x6d\x70\x73\x20\x6f\x76\x65\x72\x20\x74\x68\x65\x20\x6c\x61\x7a\x79\x20\x64\x6f\x67",
      ),
      hex_to_bytes("2fd4e1c67a2d28fced849ee1bb76e7391b93eb12"),
    ),
  )
}

