///|
test "HMAC-SHA1: trunc" {
  assert_true(
    bytes_equal(
      hmac_sha1(
        b"\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c",
        b"\x54\x65\x73\x74\x20\x57\x69\x74\x68\x20\x54\x72\x75\x6e\x63\x61\x74\x69\x6f\x6e",
      ),
      hex_to_bytes("4c1a03424b55e07fe7f27be1d58bb9324a9a5a04"),
    ),
  )
}

///|
test "HOTP RFC 4226: counter=0" {
  assert_true(
    hotp(
      b"\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30",
      0UL, 6,
    ) ==
    "755224",
  )
}

///|
test "HOTP RFC 4226: counter=1" {
  assert_true(
    hotp(
      b"\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30",
      1UL, 6,
    ) ==
    "287082",
  )
}

