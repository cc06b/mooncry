  assert_true(
    totp(
      b"\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30",
      2000000000UL, 30, 8,
    ) ==
    "69279037",
  )
}

///|
test "TOTP RFC 6238: T=20000000000" {
  assert_true(
    totp(
      b"\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30",
      20000000000UL, 30, 8,
    ) ==
    "65353130",
  )
}

///|
test "SHA-1 streaming vs one-shot" {
  let data = b"\x73\x74\x72\x65\x61\x6d\x69\x6e\x67\x20\x76\x73\x20\x6f\x6e\x65\x73\x68\x6f\x74\x20\x73\x68\x61\x31\x20\x74\x65\x73\x74\x20\x64\x61\x74\x61\x20\x31\x32\x33\x34\x35\x36\x37\x38\x39\x30"
  let one = sha1(data)
  let h = sha1_new()
  let mut off = 0
  while off < data.length() {
    let step = if off + 7 < data.length() { 7 } else { data.length() - off }
    let ca = Array::make(step, b'\x00')
    for i in 0..<step {
      ca[i] = data[off + i]
    }
    sha1_update(h, Bytes::from_array(ca[:]))
    off = off + step
  }
  assert_true(bytes_equal(one, sha1_finalize(h)))
}
