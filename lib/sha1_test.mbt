      hmac_sha1(
        b"\x4a\x65\x66\x65", b"\x77\x68\x61\x74\x20\x64\x6f\x20\x79\x61\x20\x77\x61\x6e\x74\x20\x66\x6f\x72\x20\x6e\x6f\x74\x68\x69\x6e\x67\x3f",
      ),
      hex_to_bytes("effcdf6ae5eb2fa2d27416d5f184df9c259a7c79"),
    ),
  )
}

