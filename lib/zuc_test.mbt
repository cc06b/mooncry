///|
test "ZUC modes: round trip, tamper detection and ignored trailing bits" {
  let key = b"\x17\x3d\x14\xba\x50\x03\x73\x1d\x7a\x60\x04\x94\x70\xf0\x0a\x29"
  let count = 0x12345678U
  for nbits in [0, 1, 7, 8, 9, 31, 32, 33, 63, 64, 65, 193, 512, 1000] {
    let nbytes = (nbits + 7) / 8
    // a message whose bits beyond nbits are set: neither mode may read them
    let data = zuc_ks_pattern(key, nbytes, 0xFF)
    let ct = zuc_eea3_encrypt(key, count, 5, 1, nbits, data)
    assert_true(ct.length() == nbytes, msg="eea3 output length")
    assert_true(
      bytes_equal(
        zuc_eea3_decrypt(key, count, 5, 1, nbits, ct),
        zuc_mask_bits(data, nbits),
      ),
      msg="eea3 round trip at nbits=" + nbits.to_string(),
    )
    // Bits beyond LENGTH must not influence either mode. Compare the same
    // buffer against itself with ONLY those bits cleared — the earlier form of
    // this check compared against a buffer that never differed, so it proved
    // nothing.
    let masked = zuc_mask_bits(data, nbits)
    if nbytes > 0 {
      assert_true(
        bytes_equal(zuc_eea3_encrypt(key, count, 5, 1, nbits, masked), ct),
        msg="eea3 read bits beyond LENGTH",
      )
      let mac1 = zuc_eia3_mac(key, count, 5, 1, nbits, data)
      let mac2 = zuc_eia3_mac(key, count, 5, 1, nbits, masked)
      assert_true(bytes_equal(mac1, mac2), msg="eia3 read bits beyond LENGTH")
      // a changed in-range bit must change the MAC
      if nbits > 0 {
        // flip the TOP bit of byte 0: always inside LENGTH, unlike the low
        // bits, which for nbits < 8 are beyond it and must be ignored
        let flipped = zuc_flip_top_bit(data)
        assert_false(
          zuc_eia3_verify(key, count, 5, 1, nbits, flipped, mac1),
          msg="eia3 accepted a flipped message bit",
        )
      }
      // and every parameter is bound into the MAC
      assert_false(
        zuc_eia3_verify(key, 0x12345679U, 5, 1, nbits, data, mac1),
        msg="count",
      )
      assert_false(
        zuc_eia3_verify(key, count, 6, 1, nbits, data, mac1),
        msg="bearer",
      )
      assert_false(
        zuc_eia3_verify(key, count, 5, 0, nbits, data, mac1),
        msg="direction",
      )
      assert_false(
        zuc_eia3_verify(zuc_flip_bit(key, 3), count, 5, 1, nbits, data, mac1),
        msg="key",
      )
      // a wrong-length tag is rejected, not trapped
      assert_false(zuc_eia3_verify(key, count, 5, 1, nbits, data, b""))
      assert_false(
        zuc_eia3_verify(key, count, 5, 1, nbits, data, zuc_slice(mac1, 0, 3)),
      )
    }
  }
  // keystream reuse across COUNT/BEARER/DIRECTION must not happen: the same
  // plaintext under two parameter sets gives different ciphertexts
  let pt = zuc_ks_pattern(key, 16, 0x5A)
  let c1 = zuc_eea3_encrypt(key, count, 1, 0, 128, pt)
  let c2 = zuc_eea3_encrypt(key, count, 2, 0, 128, pt)
  let c3 = zuc_eea3_encrypt(key, count, 1, 1, 128, pt)
  assert_false(bytes_equal(c1, c2), msg="eea3: bearer not bound")
  assert_false(bytes_equal(c1, c3), msg="eea3: direction not bound")
}

///|
/// `len` bytes of keystream XORed with `fill`, used as a test message.
fn zuc_ks_pattern(key : Bytes, len : Int, fill : Int) -> Bytes {
  let ks = zuc_keystream(key, key, (len + 3) / 4)
  let a = Array::make(len, (0).to_byte())
  for i in 0..<len {
    a[i] = (ks[i].to_int() ^ fill).to_byte()
  }
  Bytes::from_array(a)
}

///|
/// Zero the bits of `data` that lie beyond `nbits`.
fn zuc_mask_bits(data : Bytes, nbits : Int) -> Bytes {
  let a = data.to_array()
  let rem = nbits % 8
  if rem != 0 && a.length() > 0 {
    let last = a.length() - 1
    a[last] = (a[last].to_int() & (0xFF << (8 - rem))).to_byte()
  }
  Bytes::from_array(a)
}

///|
fn zuc_flip_top_bit(b : Bytes) -> Bytes {
  let a = b.to_array()
  a[0] = (a[0].to_int() ^ 0x80).to_byte()
  Bytes::from_array(a)
}

///|
test "ZUC-256: official keystream vectors (ZUC-256 draft / TS 35.221 v17)" {
  // vector 0: 20 keystream words
  assert_true(
    bytes_equal(
      zuc256_keystream(
        b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
        b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
        20,
      ),
      b"\x58\xd0\x3a\xd6\x2e\x03\x2c\xe2\xda\xfc\x68\x3a\x39\xbd\xcb\x03\x52\xa2\xbc\x67\xf1\xb7\xde\x74\x16\x3c\xe3\xa1\x01\xef\x55\x58\x96\x39\xd7\x5b\x95\xfa\x68\x1b\x7f\x09\x0d\xf7\x56\x39\x1c\xcc\x90\x3b\x76\x12\x74\x4d\x54\x4c\x17\xbc\x3f\xad\x8b\x16\x3b\x08\x21\x78\x7c\x0b\x97\x77\x5b\xb8\x49\x43\xc6\xbb\xe8\xad\x8a\xfd",
    ),
    msg="zuc256 official vector 0",
  )
  // vector 1: 20 keystream words
  assert_true(
    bytes_equal(
      zuc256_keystream(
        b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
        b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
        20,
      ),
      b"\x33\x56\xcb\xae\xd1\xa1\xc1\x8b\x6b\xaa\x4f\xfe\x34\x3f\x77\x7c\x9e\x15\x12\x8f\x25\x1a\xb6\x5b\x94\x9f\x7b\x26\xef\x71\x57\xf2\x96\xdd\x2f\xa9\xdf\x95\xe3\xee\x7a\x5b\xe0\x2e\xc3\x2b\xa5\x85\x50\x5a\xf3\x16\xc2\xf9\xde\xd2\x7c\xdb\xd9\x35\xe4\x41\xce\x11\x15\xfd\x0a\x80\xbb\x7a\xef\x67\x68\x98\x94\x16\xb8\xfa\xc8\xc2",
    ),
    msg="zuc256 official vector 1",
  )
}

