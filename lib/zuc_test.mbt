test "ZUC-128: official keystream vectors (GM/T 0001.1-2012)" {
  // vector 0: the first two keystream words
  assert_true(
    bytes_equal(
      zuc_keystream(
        b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00", b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
        2,
      ),
      b"\x27\xbe\xde\x74\x01\x80\x82\xda",
    ),
    msg="zuc128 official vector 0",
  )
  // vector 1: the first two keystream words
  assert_true(
    bytes_equal(
      zuc_keystream(
        b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff", b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
        2,
      ),
      b"\x06\x57\xcf\xa0\x70\x96\x39\x8b",
    ),
    msg="zuc128 official vector 1",
  )
  // vector 2: the first two keystream words
  assert_true(
    bytes_equal(
      zuc_keystream(
        b"\x3d\x4c\x4b\xe9\x6a\x82\xfd\xae\xb5\x8f\x64\x1d\xb1\x7b\x45\x5b", b"\x84\x31\x9a\xa8\xde\x69\x15\xca\x1f\x6b\xda\x6b\xfb\xd8\xc7\x66",
        2,
      ),
      b"\x14\xf1\xc2\x72\x32\x79\xc4\x19",
    ),
    msg="zuc128 official vector 2",
  )
}

