  )
  assert_true(
    bytes_equal(
      zuc256_mac(
        b"\xed\x92\x15\x16\xac\x03\x80\x84\xe4\x9c\x89\xe2\x0d\xfa\xe4\x47\xa0\x74\x00\x3b\xfe\x03\xf4\xd0\x43\x9d\xf4\x03\x53\x3f\xdd\x34",
        b"\xee\x88\x99\xc6\xf4\x62\x5d\x3b\x73\x76\x95\x36\xdd\x8c\xf0\x08\xba\x14\xf8\x60\xd6\x57\x8e",
        128, 1592, b"\x93\xb1\x15\xf3\x7f\x9f\xe0\x20\x48\xd8\x76\xbe\x05\x4f\xe3\x84\x5f\x1b\xa6\xbc\x25\xe4\xc3\xf8\x40\x84\x02\xcf\x1c\x48\x88\x8e\xb2\x84\x69\xac\x7b\x38\x32\x8f\xf7\xa5\xfc\xd9\x2f\x5a\xf0\x74\xbd\xf0\x16\x62\xf0\xf6\x6a\x95\xcd\x2d\x93\x07\x89\x58\x66\x41\x44\x0e\xf7\xf5\x0f\x99\x98\xc5\xec\x6b\x79\x1d\x65\x57\x3e\xb8\x77\x45\x84\x4a\xda\x5b\xb5\x81\x53\x25\xe5\x61\x74\x77\x4b\x73\x2e\x45\x42\xc0\x5e\x10\x15\x2f\x11\x2d\x8a\x8c\x99\xb3\xb9\x92\x53\xd7\x0c\xde\xb7\xcd\x23\x2b\xdf\x9b\x6a\x6d\x04\x01\x63\x8f\xea\x3e\x3e\xaf\x50\xfc\xed\xef\x0b\x08\xf7\xd4\xc1\xd1\xe4\x84\xa7\x62\xa3\x7b\x27\x33\xd0\x7a\x21\xe5\xd9\x72\x29\x48\x2f\x52\x49\x90\x19\x48\x02\xea\x90\x7d\x0f\x6b\xdd\x8b\x97\xc1\xb7\xf9\x0d\x36\x1b\x56\x71\x46\xf1\x05\xec\x81\xa3\x37\x70\xaf\xd3\xc7\x1f\xf5\x54\xb3\xcc\x26\x2f",
      ),
      b"\x07\x90\x44\x9c\x46\x94\xcf\xb0\xfb\x1f\xb3\x29\x22\xb8\x0a\xb4",
    ),
    msg="zuc256 mac extended vector 32 (1592 bits, 128-bit tag)",
  )
  assert_true(
    bytes_equal(
      zuc256_mac(
        b"\xed\xf2\xe4\x06\xe3\x27\xb4\xe4\xf4\xd2\x68\xdd\xe8\xdd\x2a\x8f\x32\x98\x10\x6a\xef\x5a\xbd\xfc\x09\x88\x80\xef\x4d\xcd\xb9\x69",
        b"\x61\x32\xbe\xfd\xc6\xf4\x03\xa7\x9a\x06\x5d\xe3\x18\xb3\xec\x33\x3e\xea\x18\x83\x43\x9d\xc3",
        32, 1600, b"\x50\x2d\xee\x52\x49\x8f\xc8\x69\x6f\x10\x18\x63\xbe\xb7\xbe\x43\xcc\xed\x7c\xa9\xa8\x35\x57\xb8\x84\xf4\x7e\x76\xf3\x91\x0d\x0d\x62\x18\x77\x73\xaf\xb0\xe9\xca\x6e\xd3\x76\xe8\x59\x4c\x2e\x58\x33\xba\x85\x35\x7e\x64\x3a\x6f\xf7\xc5\x03\x06\x95\xc3\xc8\xf0\x6f\x7d\xb8\x9e\x7c\x95\x0e\xdd\xd9\x86\x56\x52\xf1\x5b\xdc\x38\xcf\x06\x5a\x82\xcf\x44\xd4\x39\x6b\x84\x2a\x3a\x1f\xca\x3d\x18\x63\x8b\x98\x4e\xc6\x12\x7e\x91\xbc\x53\xef\x7c\x0e\xfc\x2a\xe6\x1b\xe9\xf1\x2d\x48\x6b\xad\xc6\xa6\xc1\xe4\x27\xef\xda\x9d\x27\x80\xb0\x6a\x83\xaf\xd3\x20\xfa\x06\x33\x08\xfe\xa4\x33\xa0\x5a\x04\xa7\xb3\x3c\xfd\x3e\x7f\x90\x22\xa1\x9b\x3f\x31\x85\x4f\xfc\xf0\xb3\x33\x45\x7e\x31\xc5\xe0\xdc\xa6\xe9\xa4\xfc\x62\xfd\x2a\x9d\xa7\x8a\x1f\xdb\x79\x54\x4b\x98\x70\x0f\x84\x1e\xb6\x0e\x4d\xc6\x84\xd0\xd7\xd8\xf7\xe3\x2d",
      ),
      b"\xbb\xd2\xd2\xd5",
    ),
    msg="zuc256 mac extended vector 33 (1600 bits, 32-bit tag)",
  )
  assert_true(
    bytes_equal(
      zuc256_mac(
        b"\x35\x2a\x85\xf4\x74\x64\xc5\x1e\x64\x1a\xc3\xf8\x7f\x54\x67\x02\x96\xb1\x85\x28\xc9\xe8\xc0\x78\x3b\x74\xb4\x3b\x3c\x02\xed\x51",
        b"\x03\xf1\x7e\xa1\xef\x0a\x53\x6f\x5a\x34\x51\x7e\x37\x08\x5d\x40\x3f\xac\xf3\x80\x90\x14\x17",
        64, 1600, b"\x08\x35\x88\xda\xae\x3e\xb3\x31\x9e\x3b\x4c\x4f\x2f\x72\x56\x47\xa8\x61\xe3\x68\x10\xb5\xd4\x75\x20\x97\xb0\x26\x5b\x35\xac\xbf\x3a\x32\x03\x57\xbf\x33\xa6\x12\x44\x39\x23\xe4\xef\x68\x3c\x42\x39\xd5\xe9\x69\x6f\x0f\x28\x6c\xad\x92\xf4\x63\xbd\x65\x3d\x99\x0b\xce\xee\xc4\xfa\x80\x79\x25\xf1\x3f\x03\x33\x60\x8d\x44\xc5\x09\x4a\x57\x8d\x81\x9f\x3e\xd9\xa5\x19\xfa\x16\xcf\x0c\xcd\x54\x9b\x63\xc3\xb1\x43\x71\xd4\xb4\xbd\x11\x10\xc0\xb4\xf0\xf4\xf4\xbe\x11\x77\x46\xe9\x5b\xaa\xd6\x64\xc1\xef\xc1\x69\xcd\xd2\x8c\x1e\xa8\xb2\x8b\xb8\xc0\xff\x75\x93\x08\x5f\xa4\x03\xf7\x81\xb9\xc2\xa5\x38\x15\x1a\x92\x50\x0c\xad\x26\xbe\x79\xd1\xeb\xf9\x82\x58\xab\x0d\x86\xaf\x2b\x31\xae\x9d\x4c\x3a\xc4\xa6\xc4\xe4\xd1\xd2\xf9\x01\xfc\xac\x42\x54\xdd\xa8\x9a\xe0\x37\x92\x0c\xb0\xed\x09\x54\x82\x6c\xed\x65\x86\xb8",
      ),
      b"\xb6\xb8\x02\x8a\xf0\xf4\xa5\x45",
    ),
    msg="zuc256 mac extended vector 34 (1600 bits, 64-bit tag)",
  )
  assert_true(
    bytes_equal(
      zuc256_mac(
        b"\x67\x7b\xf2\x85\x56\x86\x4b\xd6\x31\x52\x1f\xce\x42\x7a\x3a\xe6\x0d\x07\xb8\xd1\xb0\x8f\x23\x0b\x21\x6a\x94\x9f\x8d\x22\xb5\x05",
        b"\x83\xd7\x42\xb9\xda\x96\xc3\xc0\xba\x3d\x9b\xe8\xd5\x2d\x8c\x16\x0f\x9e\xe5\x92\x6e\x7e\x73",
        128, 1600, b"\x6d\x5f\x03\x38\xd5\x00\x08\x86\x6d\xde\xbd\x24\x40\x5c\xe3\x52\xc4\xc1\x9b\xda\x04\x2b\xbf\xba\x86\xd4\xf0\xd1\x2c\x2f\x34\x79\xcf\x8d\x48\x54\xcc\x80\x4d\x5e\xb5\x11\xda\x0f\x81\xf0\xbc\xb0\xd0\x97\x66\x5b\xbe\x90\xcf\x4f\xb1\x86\xdf\xba\x50\xa3\x2e\x67\xac\xaf\x4f\x7f\xee\xe2\x5c\xa6\x37\x04\xc1\x6b\xa0\x22\xec\x2d\x74\x42\xd1\x32\xb1\x26\x98\xd0\x7d\x38\xa5\x39\x6b\x86\xd7\xd3\xea\x0c\x30\x73\x2f\x87\x08\xec\xf1\x53\x96\x98\x53\xd5\x9a\x43\x81\xe1\xca\xa3\xa0\xc6\x3b\xdb\x96\x01\x45\xe8\x1b\x78\x14\x9e\x65\x96\x6c\x57\xeb\x18\x26\xea\x5c\x54\x68\xc6\xc5\x05\xb5\x99\x6d\x74\x36\x4d\x41\x53\xe7\x24\xe0\x70\xec\x47\x8c\xef\x08\x00\x7a\xd6\x50\x37\x88\x23\x1c\xc6\xaa\x76\x68\x3f\xd7\x14\x7d\xd7\xa7\x7c\x8e\x56\xa8\x71\x50\x07\xf8\xeb\x40\xa6\xdf\xa9\x7d\x5b\xaa\x79\xda\xdb\x52\x5c\xb6\x98",
      ),
      b"\xa0\xd6\x0d\x36\x1c\x09\x53\x0d\x92\xdc\x89\xc9\x9d\x3b\x2d\x68",
    ),
    msg="zuc256 mac extended vector 35 (1600 bits, 128-bit tag)",
  )
}

///|
test "ZUC-256: stream and MAC semantics" {
  let key = b"\x34\xf2\xe6\xb2\x1d\x8b\x81\x04\x1d\x68\x3f\xe0\x3b\x29\x8f\x38\xd6\xca\x0c\x56\x72\xf9\x5a\x27\x22\x95\x0b\xaf\x98\x43\x36\x01"
  let iv = b"\xf4\x3a\x95\x8a\xf0\x3c\x24\x6c\xf5\xe5\x27\x2b\x18\x41\xcc\x53\x98\xa1\xba\x53\x60\x42\xac"
  // raw stream mode round-trips at any length
  for n in [0, 1, 3, 4, 5, 33, 64, 1000] {
    let data = zuc_slice(zuc256_keystream(key, iv, (n + 3) / 4), 0, n)
    let ct = zuc256_xor(key, iv, data)
    assert_true(ct.length() == n, msg="zuc256_xor length")
    assert_true(
      bytes_equal(zuc256_xor(key, iv, ct), data),
      msg="zuc256_xor round trip at n=" + n.to_string(),
    )
  }
  // determinism and prefix consistency
  assert_true(
    bytes_equal(zuc256_keystream(key, iv, 8), zuc256_keystream(key, iv, 8)),
    msg="zuc256 keystream is not deterministic",
  )
  assert_true(
    bytes_equal(
      zuc_slice(zuc256_keystream(key, iv, 16), 0, 16),
      zuc256_keystream(key, iv, 4),
    ),
    msg="zuc256 keystream prefix mismatch",
  )
  // a one-bit change in key or IV changes the stream
  let ks4 = zuc256_keystream(key, iv, 4)
  assert_false(
    bytes_equal(zuc256_keystream(zuc_flip_bit(key, 0), iv, 4), ks4),
    msg="zuc256: a changed key did not change the stream",
  )
  assert_false(
    bytes_equal(zuc256_keystream(key, zuc_flip_bit(iv, 22), 4), ks4),
    msg="zuc256: a changed IV did not change the stream",
  )
  // tag sizes are domain-separated by the D row: a 32-bit tag must not be a
  // prefix of the 64-bit one for the same key/IV/message
  let msg = zuc256_pattern(key, iv, 64, 0x3C)
  let t32 = zuc256_mac(key, iv, 32, 512, msg)
  let t64 = zuc256_mac(key, iv, 64, 512, msg)
  let t128 = zuc256_mac(key, iv, 128, 512, msg)
  assert_true(t32.length() == 4 && t64.length() == 8 && t128.length() == 16)
  assert_false(
    bytes_equal(t32, zuc_slice(t64, 0, 4)),
    msg="zuc256: tag sizes are not domain-separated",
  )
  assert_false(
    bytes_equal(t64, zuc_slice(t128, 0, 8)),
    msg="zuc256: tag sizes are not domain-separated",
  )
  // bits beyond nbits are ignored: compare the same buffer against itself
  // with ONLY the out-of-range bits cleared
  let nbits = 508
  let noisy = zuc_set_tail(msg, 8, 0xFF)
  assert_true(
    bytes_equal(
      zuc256_mac(key, iv, 64, nbits, noisy),
      zuc256_mac(key, iv, 64, nbits, zuc_mask_bits(noisy, nbits)),
    ),
    msg="zuc256 mac read bits beyond nbits",
  )
  // and an in-range bit is covered
  assert_false(
    zuc256_mac_verify(
      key,
      iv,
      64,
      nbits,
      zuc_flip_top_bit(noisy),
      zuc256_mac(key, iv, 64, nbits, noisy),
    ),
    msg="zuc256 mac accepted a flipped message bit",
  )
  // a wrong-length tag is rejected, not trapped
  let t = zuc256_mac(key, iv, 64, 512, msg)
  assert_false(zuc256_mac_verify(key, iv, 64, 512, msg, b""), msg="empty tag")
  assert_false(
    zuc256_mac_verify(key, iv, 64, 512, msg, zuc_slice(t, 0, 7)),
    msg="short tag",
  )
  assert_false(
    zuc256_mac_verify(key, iv, 64, 512, msg, zuc256_pattern(key, iv, 9, 0)),
    msg="long tag",
  )
}

///|
/// `len` bytes of ZUC-256 keystream XORed with `fill` (a test message).
fn zuc256_pattern(key : Bytes, iv : Bytes, len : Int, fill : Int) -> Bytes {
  let ks = zuc256_keystream(key, iv, (len + 3) / 4)
  let a = Array::make(len, (0).to_byte())
  for i in 0..<len {
    a[i] = (ks[i].to_int() ^ fill).to_byte()
  }
  Bytes::from_array(a)
}

///|
/// Overwrite the bytes from `off` onward with `fill` (same length).
fn zuc_set_tail(b : Bytes, off : Int, fill : Int) -> Bytes {
  let a = b.to_array()
  for i = off; i < a.length(); i = i + 1 {
    a[i] = fill.to_byte()
  }
  Bytes::from_array(a)
}

///|
fn zuc_slice(b : Bytes, start : Int, len : Int) -> Bytes {
  let a = Array::make(len, (0).to_byte())
  for i in 0..<len {
    a[i] = b[start + i]
  }
  Bytes::from_array(a)
}

///|
fn zuc_flip_bit(b : Bytes, pos : Int) -> Bytes {
  let a = b.to_array()
  a[pos] = (a[pos].to_int() ^ 1).to_byte()
  Bytes::from_array(a)
}
