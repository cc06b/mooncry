// HPKE DHKEM(P-384, HKDF-SHA384) differential vectors. v0.41.0.
// Generated by the Python oracle (pycryptodome ECDH/HMAC/AES-GCM);
// the HPKE composition machinery itself is RFC 9180 vector-verified
// for P-256/P-521 (v0.38/v0.40).

///|
test "HPKE P-384 derive/encap/decap differential" {
  let suite = hpke_p384_hkdf_sha384_aes256gcm
  let ikm_r = hex_to_bytes(
    "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f2021222324252627" +
    "28292a2b2c2d2e2f",
  )
  let ikm_e = hex_to_bytes(
    "303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f5051525354555657" +
    "58595a5b5c5d5e5f",
  )
  let (pk_r, sk_r) = hpke_derive_key_pair(suite, ikm_r)
  assert_true(
    bytes_equal(
      pk_r,
      hex_to_bytes(
        "04986dc0a7d2b37e3b222ea7d25a32fc290c88c50b6a0acfdecadb83a285f19a3ef0dbceeeecf54a" +
        "9e7e02e4fb2c7bc075c24ba4c069bb3466ba3d35b29783bb51c74aa60ecfadacb1f4446327b36272" +
        "176c58d687e5318e5537176f37cc846823",
      ),
    ),
  )
  assert_true(
    bytes_equal(
      sk_r,
      hex_to_bytes(
        "98c0889aab5610522699abe5970b7b7132022094127060b928018fb3c0e2aaae9da72e0c9cf8f909d91c1e1e58f7454a",
      ),
    ),
  )
  let (ss, enc) = hpke_encap(suite, pk_r, ikm_e)
  assert_true(
    bytes_equal(
      enc,
      hex_to_bytes(
        "04508ad7a0bf66da82742955a74ed6bdb89a0f523415cb37e17cc61085ada994f32727cf95ffc2e1" +
        "a986446c0e476f884a4a366b3b0f4b45d83d4edc9901b452033957f97bc39bac9b1b216ff36571f6" +
        "3d59ba29aa68f3abc2b6aef8314e272a9c",
      ),
    ),
  )
  assert_true(
    bytes_equal(
      ss,
      hex_to_bytes(
        "7c58ebba65d0d7a61df10d5828de758facbdb6466fe2644515cbcb168680f512b93122e418e91b22" +
        "13df907e0edab900",
      ),
    ),
  )
  let ss2 = hpke_decap(suite, enc, sk_r, pk_r)
  assert_true(bytes_equal(ss2, ss))
}

///|
test "HPKE P-384 key schedule + seal/open sequence differential" {
  let suite = hpke_p384_hkdf_sha384_aes256gcm
  let ikm_e = hex_to_bytes(
    "303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f5051525354555657" +
    "58595a5b5c5d5e5f",
  )
  let pk_r = hex_to_bytes(
    "04986dc0a7d2b37e3b222ea7d25a32fc290c88c50b6a0acfdecadb83a285f19a3ef0dbceeeecf54a" +
    "9e7e02e4fb2c7bc075c24ba4c069bb3466ba3d35b29783bb51c74aa60ecfadacb1f4446327b36272" +
    "176c58d687e5318e5537176f37cc846823",
  )
  let sk_r = hex_to_bytes(
    "98c0889aab5610522699abe5970b7b7132022094127060b928018fb3c0e2aaae9da72e0c9cf8f909d91c1e1e58f7454a",
  )
  let info = hex_to_bytes(
    "6d6f6f6e6372792068706b65207033383420646966666572656e7469616c",
  )
  let (enc, ctx_s) = hpke_setup_s(suite, 0, pk_r, ikm_e, info, b"", b"", b"")
  let ctx_r = hpke_setup_r(suite, 0, sk_r, pk_r, enc, info, b"", b"", b"")
  {
    let ct = hpke_seal(ctx_s, hex_to_bytes("6161642d30"), b"")
    assert_true(
      bytes_equal(ct, hex_to_bytes("5df1c0d427f4ad9caf6be9d4084e39e8")),
    )
    match hpke_open(ctx_r, hex_to_bytes("6161642d30"), ct) {
      Some(pt) => assert_true(bytes_equal(pt, b""))
      None => assert_true(false)
    }
  }
  {
    let ct = hpke_seal(
      ctx_s,
      hex_to_bytes("6161642d30"),
      hex_to_bytes("73686f7274"),
    )
    assert_true(
      bytes_equal(
        ct,
        hex_to_bytes("77f704cefe175d5ac411e63e92e505ef583e1efc40"),
      ),
    )
    match hpke_open(ctx_r, hex_to_bytes("6161642d30"), ct) {
      Some(pt) => assert_true(bytes_equal(pt, hex_to_bytes("73686f7274")))
      None => assert_true(false)
    }
  }
  {
    let ct = hpke_seal(
      ctx_s,
      hex_to_bytes("6161642d30"),
      hex_to_bytes(
        "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f60616263",
      ),
    )
    assert_true(
      bytes_equal(
        ct,
        hex_to_bytes(
          "4662d2587629f3202c4a430beda036b4dc8b31519c32c8a0aa97546e86bd1120bcdeff64a57106d0" +
          "0360c6561804e9433edc426106c66f66ae05d36c1f5517e266310802d4c24d994986095b6933fdf8" +
          "2547a8d7ec47801cf849bd9bf7a247b2c802eccf60c1546bd240943abf2696f01d12a66b",
        ),
      ),
    )
    match hpke_open(ctx_r, hex_to_bytes("6161642d30"), ct) {
      Some(pt) =>
        assert_true(
          bytes_equal(
            pt,
            hex_to_bytes(
              "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f60616263",
            ),
          ),
        )
      None => assert_true(false)
    }
  }
  {
    let ct = hpke_seal(
      ctx_s,
      hex_to_bytes("6161642d30"),
      hex_to_bytes(
        "",
      ),
    )
    assert_true(
      bytes_equal(
        ct,
        hex_to_bytes(
          "7f7bbee02baf76e0bc27f2d282531d5a34a837d0309c94945a654f141f62be5d45c5b44e798daf9f" +
          "0ecdadd413cc29236bf6343b19034ab663d8b343dfa79413ffe86925c5be2a67217e36b510769886" +
          "1b0d23bccbdfff6c7239791c907c2dbd771e2d93c0d7321eb334f7ec5df9ec562055c86bd20771e6" +
          "accac103e02481b1d968c7284248cfa119c67ea795383ebeb16670e5d1685fb9af15147e2bbbba7e" +
          "cc59bb9c4453fcb064fa023a2e85db39d8730b373d242d23af3bde72bce3b23b5b9de5d67b2ac845" +
          "0545ddeab63ceebb714472e2005b68f8",
        ),
      ),
    )
    match hpke_open(ctx_r, hex_to_bytes("6161642d30"), ct) {
      Some(pt) =>
        assert_true(
          bytes_equal(
            pt,
            hex_to_bytes(
              "",
            ),
          ),
        )
      None => assert_true(false)
    }
  }
  assert_true(
    bytes_equal(
      hpke_export(ctx_s, b"", 48),
      hex_to_bytes(
        "3aafcd818f2f35a7b39538578f93542de3c737812fe7a555deebbb71d83b79a0e98790097856b08e" +
        "17a767c55ffae030",
      ),
    ),
  )
  assert_true(
    bytes_equal(
      hpke_export(ctx_s, hex_to_bytes("6578706f72742d637478"), 64),
      hex_to_bytes(
        "ccecb7a868a6a1bf7d4d05041058ca620e763b134a48af7535d896845b80e38814b53d2315cd4c3b" +
        "780aa59d9c7b862523ed97eaf2728dd9fc6a64da1879900e",
      ),
    ),
  )
}
