///|
test "xmssmt_oid2_keygen_sign" {
  let p = xmss_params(0, 32, 20, 5, 4)
  let seed = hex_to_bytes(
    "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f" +
    "303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f",
  )
  let sk = xmss_keygen_from_seed(p, seed)
  assert_true(
    bytes_equal(
      xmss_public_key(sk),
      hex_to_bytes(
        "2063c0b3ddf86940b17f60d5f607b1af8a2a8be6281ce5121012291e66a1f83a404142434445464748494a4b4c4d4e4f" +
        "505152535455565758595a5b5c5d5e5f",
      ),
    ),
  )
  xmss_set_index(sk, 524288)
  let msg = hex_to_bytes("25")
  let sig = xmss_sign(sk, msg)
  assert_true(
    bytes_equal(
      sig,
      hex_to_bytes(
        "080000152cafe9c871dc7677de8f9e9c100a86d01d0d6f11d971c66a3aacfcda764f2379483fb8a72b1a8c2f71fbcf31" +
        "814cebb9a10dcb996819d425525be96d2aa869045d02210481e732cbed87037ea67c46a2d0f0ce978dc90bb5435f3642" +
        "0f2de759466e9a51d829ce0cec84cc16001ea911a60a6085278123c06f3d6fe992d5924ed19528e93f480aa69fc15934" +
        "dafc22861cca01d4a4751b45bae9e62b5efdb0890389f631cef9736598d4d7252de57f15f3da185bd1adff7300ed30cb" +
