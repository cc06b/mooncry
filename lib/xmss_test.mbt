///|
test "xmss_oid1_keygen_sign" {
  let p = xmss_params(0, 32, 10, 10, 1)
  let seed = hex_to_bytes(
    "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f" +
    "303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f",
  )
  let sk = xmss_keygen_from_seed(p, seed)
  assert_true(
    bytes_equal(
      xmss_public_key(sk),
      hex_to_bytes(
        "9d898033e37af48e6a116f8b15651cc26773467007ad19375d38c23c690c3483404142434445464748494a4b4c4d4e4f" +
        "505152535455565758595a5b5c5d5e5f",
      ),
    ),
  )
  xmss_set_index(sk, 512)
  let msg = hex_to_bytes("25")
  let sig = xmss_sign(sk, msg)
  assert_true(
    bytes_equal(
      sig,
      hex_to_bytes(
        "000002008ff0300be485dea7e5ae2c56080302febc91b41318c504f895baab0b068968f222e5dd2e120538cb72d11267" +
        "ecf55f62897cb641643310f039be9757c5fa9d80f71884e32447ba71b4ff1c50ad4211c5d1075beca1a9f75730f91222" +
