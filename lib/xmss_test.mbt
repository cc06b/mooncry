    "9cabb4f8984e9a00b1cae356b21cc351c4e826285d526bc33c39480a4c12016195d5f65db69cb888217c4186960985f8" +
    "e5f0b15ca54bd23f8fb1cc9f88e82ef142f3a626dcac38c437159a7f9a2fb3e231ebeaa5bbd275075d405dbb1b85f8bf" +
    "6f99c6587f6c6c4906df24fca9ba74a99b1a485bb636d9e6c657b841eb4e5bf8275d278ca78dcd736e2994fe613cd356" +
    "af75d7ef50c1d2f48d6ab96d8bb07c619c8f040a614b776272800da320d084554a54e1acbeeb9d8fe6f6001c2f18e367" +
    "028bdcd7fd38fbdb79ad378d7e150f16fa7d7570d217572a",
  )
  let wmsg = hex_to_bytes("000306090c0f1215181b1e2124272a2d303336393c3f4245")
  let sig = xmss_wots_sign(
    p,
    sk_seed,
    pub_seed,
    [0, 500000000, 1000000000, 1500000000, 2000000000, 50, 10, 1],
    wmsg,
  )
  assert_true(bytes_equal(sig, wsig))
  let pk2 = xmss_wots_pk_from_sig(p, wsig, wmsg, pub_seed, [
    0U, 500000000U, 1000000000U, 1500000000U, 2000000000U, 50U, 10U, 1U,
  ])
  assert_true(bytes_equal(pk2, wpk))
  let leaf = xmss_gen_leaf_wots(
    p,
    sk_seed,
    pub_seed,
    [0, 500000000, 1000000000, 1500000000, 2000000000, 50, 10, 1],
    [
      0U, 400000000U, 800000000U, 1200000000U, 1600000000U, 2000000000U, 2400000000U,
      2800000000U,
    ],
  )
  assert_true(
    bytes_equal(
      leaf,
      hex_to_bytes("ba03b458a7b0e1b87e15473dcb6596074e148c7ba59ba296"),
    ),
  )
}

