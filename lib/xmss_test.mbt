///|
test "xmssmt_oid34_keygen_sign" {
  let p = xmss_params(0, 24, 20, 5, 4)
  let seed = hex_to_bytes(
    "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f" +
    "303132333435363738393a3b3c3d3e3f4041424344454647",
  )
  let sk = xmss_keygen_from_seed(p, seed)
  assert_true(
    bytes_equal(
      xmss_public_key(sk),
      hex_to_bytes(
        "52c6f5642a6c2683ea3fc9c3191a16af91527b34630f0133303132333435363738393a3b3c3d3e3f4041424344454647",
      ),
    ),
  )
  xmss_set_index(sk, 524288)
  let msg = hex_to_bytes("25")
  let sig = xmss_sign(sk, msg)
  assert_true(
    bytes_equal(
      sig,
      hex_to_bytes(
        "080000146ae53c9054a5e72a5ff1e9072335593631d848de9cfc29ae2cefe95c7b1f4ce1ff54652bb27f2f085f4b7c0a" +
