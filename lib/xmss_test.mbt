      2800000000U,
    ],
  )
  assert_true(
    bytes_equal(
      leaf,
      hex_to_bytes(
        "2e8ff5de35350e3601baff2d49e561f06f4e6235343769db6ed84b471d669c8186a123e10d74e140e6a985ba5060594d" +
        "4c9f7f3059778a15d21dfc7c5cb14aff",
      ),
    ),
  )
}

