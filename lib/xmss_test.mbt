///|
test "xmssmt_oid42_keygen_sign" {
  let p = xmss_params(2, 32, 20, 5, 4)
  let seed = hex_to_bytes(
    "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f" +
    "303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f",
  )
  let sk = xmss_keygen_from_seed(p, seed)
  assert_true(
    bytes_equal(
      xmss_public_key(sk),
      hex_to_bytes(
        "c1d281bf4510b02f0b61980b99c85f3268d42267040016d6b9194c2f3b040f1a404142434445464748494a4b4c4d4e4f" +
        "505152535455565758595a5b5c5d5e5f",
      ),
    ),
  )
  xmss_set_index(sk, 524288)
  let msg = hex_to_bytes("25")
  let sig = xmss_sign(sk, msg)
  assert_true(
    bytes_equal(
      sig,
      hex_to_bytes(
        "080000bafcebcb9e55ecb1a34ae795c74bc20311d62a6f4a38d7eaac027ef5fdc974c3b20022146b602565d38b7bf844" +
        "68674af7d53457c6a91b26fe0a8b3c3765621e3a6429071bd40dc58992615fea39ad984cb1b5d4622ef07fa27cd5417d" +
        "c4413071e098bb2834b9f8d7eed5db5aaba160001abcc90862ec6bd27a0df62fe22ffbc2a4115dcd7bb9792d09145801" +
        "339a65f742757b421188ccd5a001453495df3e21ba2cc54318a85c686fdb5842113426c7c3196ad8b08962e3d623339b" +
        "a7a1c61043507de4565d40f881b61dcc2f6bdc264478dcc3332726dfb2fe2d51fd52861db78826d62bf3d5fdf692745b" +
        "ed905b527acbbc2a87b1932feb379c03bcbd2146fcbe458b3310b8c7dfee2b250cdaf20a48f327151c260c1be5dac3f7" +
