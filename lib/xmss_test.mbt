/// XMSS/XMSS^MT (RFC 8391) tests — deterministic KATs from the official
/// reference implementation (github.com/XMSS/xmss-reference, CC0):
/// seed[i]=i, msg={37}, index=2^(H-1); digests cross-checked against
/// the reference test/vectors.c output.
/// Byte-exact keygen+sign is run for XMSS oid 1 (SHA2_10_256; the
/// ~1M-hash H10 trees make more repetitions too slow for CI) and all
/// XMSS^MT sets (tree_height 5); the other XMSS sets are covered by
/// verification against their official signatures.

///|
test "wots_oid1" {
  let p = xmss_params(0, 32, 10, 10, 1)
  let sk_seed = hex_to_bytes(
    "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
  )
  let pub_seed = hex_to_bytes(
    "00020406080a0c0e10121416181a1c1e20222426282a2c2e30323436383a3c3e",
