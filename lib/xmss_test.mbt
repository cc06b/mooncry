///|
test "xmssmt_oid50_keygen_sign" {
  let p = xmss_params(2, 24, 20, 5, 4)
  let seed = hex_to_bytes(
    "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f" +
    "303132333435363738393a3b3c3d3e3f4041424344454647",
  )
  let sk = xmss_keygen_from_seed(p, seed)
  assert_true(
    bytes_equal(
      xmss_public_key(sk),
      hex_to_bytes(
        "296d594ddd9688b47a9c461c70e3d9f29e901b8cedcaaa4c303132333435363738393a3b3c3d3e3f4041424344454647",
      ),
    ),
  )
  xmss_set_index(sk, 524288)
  let msg = hex_to_bytes("25")
  let sig = xmss_sign(sk, msg)
  assert_true(
    bytes_equal(
      sig,
      hex_to_bytes(
        "080000e0199594beac866b26fa250a5fde4028ec2babeab58ccba3ff9f2706ce0e09f8edb7d281d38a0e735166ccc7b9" +
