///|
test "xmssmt_oid26_keygen_sign" {
  let p = xmss_params(2, 64, 20, 5, 4)
  let seed = hex_to_bytes(
    "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f" +
    "303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f" +
    "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f" +
    "909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf",
  )
  let sk = xmss_keygen_from_seed(p, seed)
  assert_true(
    bytes_equal(
      xmss_public_key(sk),
      hex_to_bytes(
        "cb048bba70e3a312f974e84317c2fa1fddef98fd32dd53db07d958b378b3de295ab24863292075a793a34303550c3258" +
        "cc374e85f0cb92071aec249f1b957f9f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f" +
        "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf",
      ),
    ),
  )
  xmss_set_index(sk, 524288)
  let msg = hex_to_bytes("25")
  let sig = xmss_sign(sk, msg)
  assert_true(
    bytes_equal(
      sig,
      hex_to_bytes(
        "080000d932915ecd713e38fbecbe9c804e8436ebbddd1aab554eb2a5a1b2a4a402fd558e41599cada466552c478d3098" +
