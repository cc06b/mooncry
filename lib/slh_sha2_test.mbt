// SLH-DSA (SHA2 family) ACVP vectors. v0.31.0.

///|
test "SLH SLH-DSA-SHA2-128s keyGen ACVP #1" {
  let (pk, sk) = slh_keygen(slh_sha2_128s,
    hex_to_bytes("173D04C938C1C36BF289C3C022D04B14"),
    hex_to_bytes("63AE23C41AA546DA589774AC20B745C4"),
    hex_to_bytes("0D794777914C99766827F0F09CA972BE"))
  assert_true(bytes_equal(pk, hex_to_bytes(
    "0D794777914C99766827F0F09CA972BE0162C10219D422ADBA1359E6AA65299C")))
  assert_true(bytes_equal(sk, hex_to_bytes(
    "173D04C938C1C36BF289C3C022D04B1463AE23C41AA546DA589774AC20B745C40D794777914C9976" +
    "6827F0F09CA972BE0162C10219D422ADBA1359E6AA65299C")))
}

///|
test "SLH SLH-DSA-SHA2-128f keyGen ACVP #21" {
  let (pk, sk) = slh_keygen(slh_sha2_128f,
    hex_to_bytes("C42BCB3B5A6F331F5CCE899253C6D9E2"),
    hex_to_bytes("9FF2B7EAD7A04BAB1794DB8CC659C3B4"),
    hex_to_bytes("A868F1BD5DEBC12D4C9FAD66AABD0A94"))
  assert_true(bytes_equal(pk, hex_to_bytes(
    "A868F1BD5DEBC12D4C9FAD66AABD0A94B546DF247BE4C457F3D467CDFCFABD39")))
  assert_true(bytes_equal(sk, hex_to_bytes(
    "C42BCB3B5A6F331F5CCE899253C6D9E29FF2B7EAD7A04BAB1794DB8CC659C3B4A868F1BD5DEBC12D" +
    "4C9FAD66AABD0A94B546DF247BE4C457F3D467CDFCFABD39")))
}

///|
test "SLH SLH-DSA-SHA2-192s keyGen ACVP #41" {
  let (pk, sk) = slh_keygen(slh_sha2_192s,
    hex_to_bytes("040266529C1864088925506C20A624A2B6D50CD77C1C6F0D"),
    hex_to_bytes("2841150AE8157512EF34A343FFEA77FF7D9E814B45A8B414"),
    hex_to_bytes("64462665F4202886206A8F632267186CA6A1CAD08A2B9A86"))
  assert_true(bytes_equal(pk, hex_to_bytes(
    "64462665F4202886206A8F632267186CA6A1CAD08A2B9A862C6A7BC4AC4AAA84ACCEF60D529F0311" +
    "274F205E8DA642C9")))
  assert_true(bytes_equal(sk, hex_to_bytes(
    "040266529C1864088925506C20A624A2B6D50CD77C1C6F0D2841150AE8157512EF34A343FFEA77FF" +
    "7D9E814B45A8B41464462665F4202886206A8F632267186CA6A1CAD08A2B9A862C6A7BC4AC4AAA84" +
    "ACCEF60D529F0311274F205E8DA642C9")))
}

///|
test "SLH SLH-DSA-SHA2-192f keyGen ACVP #61" {
  let (pk, sk) = slh_keygen(slh_sha2_192f,
    hex_to_bytes("A021B4B9D6DEE168722BC10225E50A946642AF630C3C7C7D"),
    hex_to_bytes("69E3A40BA09DF2AC165B792A07F064AC5FC28D8C99A580F4"),
    hex_to_bytes("EE4823D09E79854706DAA80AE3179B5BC8C2E9409D6328A3"))
  assert_true(bytes_equal(pk, hex_to_bytes(
    "EE4823D09E79854706DAA80AE3179B5BC8C2E9409D6328A33577FD584BC0784C559CDB2437A46F7F" +
    "753C336369419ACF")))
  assert_true(bytes_equal(sk, hex_to_bytes(
    "A021B4B9D6DEE168722BC10225E50A946642AF630C3C7C7D69E3A40BA09DF2AC165B792A07F064AC" +
    "5FC28D8C99A580F4EE4823D09E79854706DAA80AE3179B5BC8C2E9409D6328A33577FD584BC0784C" +
    "559CDB2437A46F7F753C336369419ACF")))
}

///|
test "SLH SLH-DSA-SHA2-256s keyGen ACVP #81" {
  let (pk, sk) = slh_keygen(slh_sha2_256s,
    hex_to_bytes("FCBF36A9807B30697BE063A5105E091B412A391DD39E1326EBA23CBD4096CA77"),
    hex_to_bytes("EF4121C08DD71BE913572F1F91E57D0ACBCD5CEC28539AC275832BBAA6C11081"),
    hex_to_bytes("A0B4F5549EBCADB951DC2E512C76B0620D8FB8100B4EE886EF8784780D52A254"))
  assert_true(bytes_equal(pk, hex_to_bytes(
    "A0B4F5549EBCADB951DC2E512C76B0620D8FB8100B4EE886EF8784780D52A2543E57AB494D47068F" +
    "FEE4B8244AAD6F19CDF94A2172BD134A15A6B5F298D5A80E")))
  assert_true(bytes_equal(sk, hex_to_bytes(
    "FCBF36A9807B30697BE063A5105E091B412A391DD39E1326EBA23CBD4096CA77EF4121C08DD71BE9" +
    "13572F1F91E57D0ACBCD5CEC28539AC275832BBAA6C11081A0B4F5549EBCADB951DC2E512C76B062" +
    "0D8FB8100B4EE886EF8784780D52A2543E57AB494D47068FFEE4B8244AAD6F19CDF94A2172BD134A" +
    "15A6B5F298D5A80E")))
}

///|
test "SLH SLH-DSA-SHA2-256f keyGen ACVP #101" {
  let (pk, sk) = slh_keygen(slh_sha2_256f,
    hex_to_bytes("18523702A0FE2C9E488948B127185BAB93D3F02C3D7C23A1B379F762DE0509E5"),
    hex_to_bytes("6AB0D9F93540BD809D1D2E8A050440AA81E853750470E2B00C959DBD3BE40E2B"),
    hex_to_bytes("D7125F5D00BA47F1FC8D4C32C2F57C444BD384D7CE770BC50DD5980C1D1264D0"))
  assert_true(bytes_equal(pk, hex_to_bytes(
    "D7125F5D00BA47F1FC8D4C32C2F57C444BD384D7CE770BC50DD5980C1D1264D00AD5197FFCBAAFE1" +
    "1B1E413F26ADB1504CE1C3F5C40C1DCDA14E99FD126D5B81")))
  assert_true(bytes_equal(sk, hex_to_bytes(
    "18523702A0FE2C9E488948B127185BAB93D3F02C3D7C23A1B379F762DE0509E56AB0D9F93540BD80" +
    "9D1D2E8A050440AA81E853750470E2B00C959DBD3BE40E2BD7125F5D00BA47F1FC8D4C32C2F57C44" +
    "4BD384D7CE770BC50DD5980C1D1264D00AD5197FFCBAAFE11B1E413F26ADB1504CE1C3F5C40C1DCD" +
    "A14E99FD126D5B81")))
}

