        b"\xa0\x47\xec\x33\x69\x15\x89\x55\x9c\xa2\x77\x84\x06\x59\x4c\x06\x34\x8f\xe9\x4c\x17\x4f\xde",
        128, 508, b"\x92\x4e\x5c\xdc\x86\xc7\x49\x23\xfe\xba\xb3\xc1\x8e\x82\x41\x9c\xaf\x31\x54\x2d\x34\xd6\xc4\x46\xf6\x5c\x81\x0d\xfe\x6c\x4c\x57\xec\x3e\x42\x82\x12\xf1\x1c\x35\x82\xc3\x88\x1a\x31\xf0\xee\xaa\x6d\x5d\xf9\xb8\xd2\xb8\x3a\x44\x5a\x01\xb2\xd8\x71\xd0\x89\xe9",
      ),
      b"\x7d\x50\xdf\x0c\x2b\x45\x95\xa9\xf5\xa9\x20\x3f\xfc\xf9\xc5\x02",
    ),
    msg="zuc256 mac edge 50 (508 bits, 128-bit tag)",
  )
  assert_true(
    bytes_equal(
      zuc256_mac(
        b"\xf7\x61\x81\x67\x23\x07\x55\xa5\xf6\x9b\x6a\xbe\xdd\x19\x83\xc1\x0c\xc8\x0c\xff\x67\xae\xd2\xd4\xd0\x8e\x49\x59\x31\xaf\x3c\x05",
        b"\xa0\x47\xec\x33\x69\x15\x89\x55\x9c\xa2\x77\x84\x06\x59\x4c\x06\x34\x8f\xe9\x4c\x17\x4f\xde",
        128, 508, b"\x92\x4e\x5c\xdc\x86\xc7\x49\x23\xfe\xba\xb3\xc1\x8e\x82\x41\x9c\xaf\x31\x54\x2d\x34\xd6\xc4\x46\xf6\x5c\x81\x0d\xfe\x6c\x4c\x57\xec\x3e\x42\x82\x12\xf1\x1c\x35\x82\xc3\x88\x1a\x31\xf0\xee\xaa\x6d\x5d\xf9\xb8\xd2\xb8\x3a\x44\x5a\x01\xb2\xd8\x71\xd0\x89\xef",
      ),
      b"\x7d\x50\xdf\x0c\x2b\x45\x95\xa9\xf5\xa9\x20\x3f\xfc\xf9\xc5\x02",
    ),
    msg="zuc256 mac edge 51 (508 bits, 128-bit tag, tail bits beyond LENGTH set)",
  )
}

///|
test "ZUC 128-EIA3: empty message (compiled-reference differential)" {
  // nbits=0: MAC-I = K0 ^ K1 of the EIA3 keystream (COUNT=0x0 BEARER=0 DIRECTION=0)
  assert_true(
    bytes_equal(
      zuc_eia3_mac(
        b"\x1d\x4c\x08\x4c\xa6\x59\x3a\xdd\xfc\xa0\xce\x66\xbf\xe6\x80\xcc", 0U,
        0, 0, 0, b"",
      ),
      b"\x6e\x05\x74\x5c",
    ),
    msg="eia3 empty message 0",
  )
  assert_true(
    zuc_eia3_verify(
      b"\x1d\x4c\x08\x4c\xa6\x59\x3a\xdd\xfc\xa0\xce\x66\xbf\xe6\x80\xcc", 0U, 0,
      0, 0, b"", b"\x6e\x05\x74\x5c",
    ),
    msg="eia3_verify rejected its own empty-message MAC (0)",
  )
  // nbits=0: MAC-I = K0 ^ K1 of the EIA3 keystream (COUNT=0x12345678 BEARER=5 DIRECTION=1)
  assert_true(
    bytes_equal(
      zuc_eia3_mac(
        b"\xda\xb2\x8d\xa7\xb1\xea\x12\xe7\x47\x4f\x00\x1d\xf2\x70\x3f\x2b", 305419896U,
        5, 1, 0, b"",
      ),
      b"\x13\x7b\x12\x63",
    ),
    msg="eia3 empty message 1",
  )
  assert_true(
    zuc_eia3_verify(
      b"\xda\xb2\x8d\xa7\xb1\xea\x12\xe7\x47\x4f\x00\x1d\xf2\x70\x3f\x2b", 305419896U,
      5, 1, 0, b"", b"\x13\x7b\x12\x63",
    ),
    msg="eia3_verify rejected its own empty-message MAC (1)",
  )
  // nbits=0: MAC-I = K0 ^ K1 of the EIA3 keystream (COUNT=0xffffffff BEARER=31 DIRECTION=0)
  assert_true(
    bytes_equal(
      zuc_eia3_mac(
        b"\xb6\x97\x08\xd0\xc0\xfc\xfc\x63\x53\x7d\x49\xf9\x13\xfc\x84\x28", 4294967295U,
        31, 0, 0, b"",
      ),
      b"\xae\x48\xba\xe2",
    ),
    msg="eia3 empty message 2",
  )
  assert_true(
    zuc_eia3_verify(
      b"\xb6\x97\x08\xd0\xc0\xfc\xfc\x63\x53\x7d\x49\xf9\x13\xfc\x84\x28", 4294967295U,
      31, 0, 0, b"", b"\xae\x48\xba\xe2",
    ),
    msg="eia3_verify rejected its own empty-message MAC (2)",
  )
}
