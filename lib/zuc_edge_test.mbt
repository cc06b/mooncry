// ========== ZUC edge cases: bit-granular MAC lengths and nbits=0 ==========
// GENERATED FILE — regenerate with:
//   python agent_box/_vectors/_gen_zuc_edge_tests.py
//
// Two gaps this closes, both against the compiled GmSSL reference:
//
//   * every ZUC-256 MAC vector in zuc_test.mbt is a whole number of bytes
//     (8..1600 bits), because the original oracle CLI feeds the reference
//     with update(msg, len) by byte count. GmSSL's zuc256_mac_finish() also
//     takes a 1..7-bit tail, so Temp/zuc-oracle/oracle_bit.c adds a
//     `mac256b <key> <iv> <macbits> <nbits> <msg>` command; these vectors
//     pin the bit-granular path (1, 7, 9, 31, 33, 63, 65, 508 bits).
//   * nbits=0 was covered for 128-EEA3 only, not for 128-EIA3 or the
//     ZUC-256 MAC.
//
// Half of the ZUC-256 cases are "ignored bits" variants: the same key, IV
// and nbits, with the tail byte's unused low bits forced to 1. The
// reference produces the identical tag for both (verified while generating
// this file), so the pair is a differential assertion that bits beyond
// LENGTH are not part of the message — not a self-referential one.
//
// Oracle: Temp/zuc-oracle/zuc_oracle_bit (GmSSL zuc.c / zuc_modes.c built
// under WSL), self-checked before use: `mac256b` at a byte-multiple length
// must equal the original `mac256` command byte for byte.

///|
test "ZUC-256 MAC: bit-granular lengths (compiled-reference differential)" {
  assert_true(
    bytes_equal(
      zuc256_mac(
        b"\x8f\xe3\xc5\x4d\x88\x01\x84\x3f\xaf\x94\x78\x56\xce\x18\xfc\x22\x8c\x48\xa8\xf8\x9e\x34\x0f\xb7\xf9\x26\x1e\x03\xf8\x71\xd0\x65",
        b"\x58\xa3\x5a\x3c\x99\x70\x2f\x01\x1c\xb5\xf9\x34\x65\x60\xd6\xf3\x97\x46\xa5\xb2\x1d\x27\xe9",
        32, 0, b"",
      ),
      b"\x4c\x65\x6f\xbf",
    ),
    msg="zuc256 mac edge 1 (0 bits, 32-bit tag)",
  )
  assert_true(
    bytes_equal(
      zuc256_mac(
        b"\x40\x56\x1a\xd7\x90\x3b\x67\x94\x0e\xb2\x58\xee\xb0\xcb\x4d\x6f\xc7\x74\xac\x25\xcc\x5c\x38\x74\xd5\x78\x76\xe1\x10\x45\x97\x53",
        b"\xd5\xc1\x91\x2d\x67\x81\xd4\x1c\x25\x54\x89\xae\x45\xa3\x4a\x76\x12\x62\x3d\x70\xfd\xa2\x20",
        32, 1, b"\xfa",
      ),
      b"\xf4\x82\x8b\x2f",
    ),
    msg="zuc256 mac edge 2 (1 bits, 32-bit tag)",
  )
  assert_true(
    bytes_equal(
