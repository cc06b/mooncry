// ==================== HKDF / PBKDF2 over SHA-3 ====================
// Vectors cross-checked against Python hmac + hashlib (sha3_256).

///|
test "HKDF-SHA3-256" {
  let okm = hkdf_sha3_256(
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09", b"\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b",
    b"\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9", 42,
  )
  assert_true(
    bytes_equal(
      okm, b"\xae\xa0\x2b\xe0\xde\x38\xaa\x9a\xa6\xa7\x59\xdc\xf4\xa8\xf9\xf9\xba\xb8\x02\x7a\x26\x43\x87\x1c\x0f\x26\x6e\x52\x75\xd8\x6b\x59\x61\x84\xb3\x31\xee\xd9\xbd\x2c\xe5\x0f",
    ),
  )
}

///|
test "PBKDF2-HMAC-SHA3-256" {
  let dk = pbkdf2_hmac_sha3_256(
    b"\x70\x61\x73\x73\x77\x6f\x72\x64", b"\x73\x61\x6c\x74", 1000, 32,
  )
  assert_true(
    bytes_equal(
      dk, b"\xee\x56\xa9\xb7\x31\x1b\xb0\x81\xd0\xbb\xfa\x8d\xc3\xc2\x79\x8f\x30\xab\xbb\xec\x63\x44\x42\x68\x29\xd9\x56\xed\x06\xea\xec\xab",
    ),
  )
}
