// SLH-DSA (SHAKE family) ACVP vectors. v0.31.0.

///|
test "SLH SLH-DSA-SHAKE-128s keyGen ACVP #11" {
  let (pk, sk) = slh_keygen(
    slh_shake_128s,
    hex_to_bytes("C151951F3811029239B74ADD24C506AF"),
    hex_to_bytes("DD30363E156E6FE936EC6ED0231FEB5C"),
    hex_to_bytes("529FFE86200D1F32C2B60D0CD909F190"),
  )
  assert_true(
    bytes_equal(
      pk,
      hex_to_bytes(
        "529FFE86200D1F32C2B60D0CD909F1900761F9B727AFA724B47223016BB5B2BA",
      ),
    ),
  )
  assert_true(
    bytes_equal(
      sk,
      hex_to_bytes(
        "C151951F3811029239B74ADD24C506AFDD30363E156E6FE936EC6ED0231FEB5C529FFE86200D1F32" +
        "C2B60D0CD909F1900761F9B727AFA724B47223016BB5B2BA",
      ),
    ),
  )
}

///|
test "SLH SLH-DSA-SHAKE-128f keyGen ACVP #31" {
  let (pk, sk) = slh_keygen(
    slh_shake_128f,
    hex_to_bytes("3956AB391B4D22FC907AF0740326D061"),
    hex_to_bytes("AB0EB206436F2B86EBE086D77739B3E4"),
    hex_to_bytes("56505C229F4E7FA6B201714C7DCC9DA3"),
  )
  assert_true(
    bytes_equal(
      pk,
      hex_to_bytes(
        "56505C229F4E7FA6B201714C7DCC9DA366578F1F24C3FE371C97C14CE0E79CDC",
      ),
    ),
  )
  assert_true(
    bytes_equal(
      sk,
      hex_to_bytes(
        "3956AB391B4D22FC907AF0740326D061AB0EB206436F2B86EBE086D77739B3E456505C229F4E7FA6" +
        "B201714C7DCC9DA366578F1F24C3FE371C97C14CE0E79CDC",
      ),
    ),
  )
}

///|
test "SLH SLH-DSA-SHAKE-192s keyGen ACVP #51" {
  let (pk, sk) = slh_keygen(
    slh_shake_192s,
    hex_to_bytes("8732621860E9A6E1887BE55F7AF692B98EB4C10B2599F94A"),
    hex_to_bytes("D5CC9D6470D8B21136158E8B1710F1FBE03ECED37ED4AC68"),
    hex_to_bytes("53FC64D46D7E1653EBBB36ED5FBC12C6E7CEF3CB756482C8"),
  )
  assert_true(
    bytes_equal(
      pk,
      hex_to_bytes(
        "53FC64D46D7E1653EBBB36ED5FBC12C6E7CEF3CB756482C8C620452E864E8497E1B38A7B04449219" +
        "ACD9E4393F9C88EF",
      ),
    ),
  )
  assert_true(
    bytes_equal(
      sk,
      hex_to_bytes(
        "8732621860E9A6E1887BE55F7AF692B98EB4C10B2599F94AD5CC9D6470D8B21136158E8B1710F1FB" +
        "E03ECED37ED4AC6853FC64D46D7E1653EBBB36ED5FBC12C6E7CEF3CB756482C8C620452E864E8497" +
        "E1B38A7B04449219ACD9E4393F9C88EF",
      ),
    ),
  )
}

///|
test "SLH SLH-DSA-SHAKE-192f keyGen ACVP #71" {
  let (pk, sk) = slh_keygen(
    slh_shake_192f,
    hex_to_bytes("FB7A2C2C75CE6C96B5F4328E0AB300476FC6F864CB5B0B99"),
    hex_to_bytes("990ECB726CA822A4E3652DD92EC0AAB7637EA41C0482AE28"),
    hex_to_bytes("68DCC671E3534F81A352C275B6A25F906D2ED0FF62B8B4E3"),
  )
  assert_true(
    bytes_equal(
      pk,
      hex_to_bytes(
        "68DCC671E3534F81A352C275B6A25F906D2ED0FF62B8B4E398F1A9876CB082A48E9AE2C862B28948" +
        "6A3925CEFC6FF4BE",
      ),
    ),
  )
  assert_true(
    bytes_equal(
      sk,
      hex_to_bytes(
        "FB7A2C2C75CE6C96B5F4328E0AB300476FC6F864CB5B0B99990ECB726CA822A4E3652DD92EC0AAB7" +
        "637EA41C0482AE2868DCC671E3534F81A352C275B6A25F906D2ED0FF62B8B4E398F1A9876CB082A4" +
        "8E9AE2C862B289486A3925CEFC6FF4BE",
      ),
    ),
  )
}

///|
test "SLH SLH-DSA-SHAKE-256s keyGen ACVP #91" {
  let (pk, sk) = slh_keygen(
    slh_shake_256s,
    hex_to_bytes(
      "E440E39644A11A6A58E850C09C8F03C273E465237F3BEF7C58DE62281E676CEA",
    ),
    hex_to_bytes(
      "99C199C00DB30F8499A61B5B9DC8A361725F6AE80E97037176F408C30B38844D",
    ),
    hex_to_bytes(
      "D7B5E755B4879FDE3288A21AF3E32FBB006FD9B8BC2B180EB9B0D82C9F3157AF",
    ),
  )
  assert_true(
    bytes_equal(
      pk,
      hex_to_bytes(
        "D7B5E755B4879FDE3288A21AF3E32FBB006FD9B8BC2B180EB9B0D82C9F3157AF02ACD6B3198EE1C9" +
        "FE9AFE61FD86D1E0877AD9061980B57B178CE27191D8EB1B",
      ),
    ),
  )
  assert_true(
    bytes_equal(
      sk,
      hex_to_bytes(
        "E440E39644A11A6A58E850C09C8F03C273E465237F3BEF7C58DE62281E676CEA99C199C00DB30F84" +
        "99A61B5B9DC8A361725F6AE80E97037176F408C30B38844DD7B5E755B4879FDE3288A21AF3E32FBB" +
        "006FD9B8BC2B180EB9B0D82C9F3157AF02ACD6B3198EE1C9FE9AFE61FD86D1E0877AD9061980B57B" +
        "178CE27191D8EB1B",
      ),
    ),
  )
}

///|
test "SLH SLH-DSA-SHAKE-256f keyGen ACVP #111" {
  let (pk, sk) = slh_keygen(
    slh_shake_256f,
    hex_to_bytes(
      "2AC9403858D186B172EDD8DF9C78A11449893681487D3AF0DAD0EC341E8ACA48",
    ),
    hex_to_bytes(
      "AFA2771BAE6C17DD6F77B4E3808B05F56F31B8F4128DF2CCB677F0283CFB18DA",
    ),
    hex_to_bytes(
      "559BC883105E8BA0264648B532626155F87EDB4BEDCFC12A24204D3B696D5370",
    ),
  )
  assert_true(
    bytes_equal(
      pk,
      hex_to_bytes(
        "559BC883105E8BA0264648B532626155F87EDB4BEDCFC12A24204D3B696D53707A158FF5D30E3428" +
        "183A3B3A96A0E4A341A2A16E5A6226AF374D1EFB39A35DF6",
      ),
    ),
  )
  assert_true(
    bytes_equal(
      sk,
      hex_to_bytes(
        "2AC9403858D186B172EDD8DF9C78A11449893681487D3AF0DAD0EC341E8ACA48AFA2771BAE6C17DD" +
        "6F77B4E3808B05F56F31B8F4128DF2CCB677F0283CFB18DA559BC883105E8BA0264648B532626155" +
        "F87EDB4BEDCFC12A24204D3B696D53707A158FF5D30E3428183A3B3A96A0E4A341A2A16E5A6226AF" +
        "374D1EFB39A35DF6",
      ),
    ),
  )
}

///|
test "SLH SLH-DSA-SHAKE-128f sigGen pure det ACVP #58" {
  let sk = hex_to_bytes(
    "29B12FEFB5411A79AAF84B3CBF8A02218E2B5A524FDC4A8D8279DB47DD74B5A84F190B458385EF8E" +
    "BD1C6FCAF8F41657E9A0392166A29A3B05AB262627011DC9",
  )
  let msg = hex_to_bytes(
    "00FFDCA5C6F2279728713DD597E26220A44424314B9ED8DEE43E812121CACD0548049C6FC08F31E2" +
    "740EA444A6066C7EABFAF2B6C896649C6E9C35F8D49BA6CDB6E3DC03600E1A96FBECC7AF3B477A19" +
    "3656BCC79783E82408FC7DDB262CCF3CBEDF8C2120A3D468C1893AB1BB6C99EC785B25A4D764AD42" +
    "05FCA73576DC20359E831CD434F2755CFA942B44C5EE20B032F4B747626DBFDAB4C01495FFCFFDED" +
    "CE009FDB1CCBE02FA38811973F61031A91A70473C9EF363D5F399F142218E40C2B6AA6C908B25736" +
    "67813698AB1E1454D537AEE3DC285774C9A88E740248B0D920BDB553B5D851408BE19C2164FFE6ED" +
    "ADA25CD3F204CAE1BE5B",
  )
  let ctx = hex_to_bytes(
    "0574B468E6D8487D5A61E3EB9ED9013F778FF989A25BC7726DB90C9FEBECBD42C3066CC8212EFC8A" +
    "D827E9C34D5F",
  )
  let sig = slh_sign(slh_shake_128f, sk, msg, ctx)
  assert_true(
    bytes_equal(
      sig,
      hex_to_bytes(
        "7C9F71ABD898CBF659E8026B382980D47670F487CAC1ED5E188E0BD6605A1F4FF9537DF60E89B85B" +
