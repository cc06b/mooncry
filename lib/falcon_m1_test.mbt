// Falcon M1 tests: hash_to_point + codecs vs official PQClean C dumps
// (falcon_m1_vectors.txt, generated by falcon_m1.exe from the clean
// reference implementation with a deterministic harness).

///|
fn m1_nonce() -> Bytes {
  let a : Array[Byte] = []
  for
    v in [
      103, 147, 241, 192, 20, 22, 204, 101, 60, 112, 110, 112, 10, 174, 220, 240,
      65, 250, 7, 204, 149, 178, 132, 100, 34, 230, 84, 60, 141, 223, 19, 156, 61,
      112, 248, 1, 76, 169, 177, 115,
    ] {
    a.push(v.to_byte())
  }
  Bytes::from_array(a)
}

///|
fn m1_bytes_to_ints(b : Bytes) -> Array[Int] {
  let a : Array[Int] = []
  for i = 0; i < b.length(); i = i + 1 {
    a.push(b[i].to_int())
  }
  a
}

///|
fn m1_arr_eq(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i = 0; i < a.length(); i = i + 1 {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

