  }
  let enc = falcon_comp_encode(x, 9)
  inspect(enc.length(), content="914")
  inspect(m1_arr_eq(m1_bytes_to_ints(enc), exp_enc), content="true")
  let dec = falcon_comp_decode(enc, 9)
  inspect(m1_arr_eq(dec, x), content="true")
  // "-0" rejection: encode 0 then flip sign bit in stream -> decode fails
  let zeros : Array[Int] = Array::make(512, 0)
  let z = falcon_comp_encode(zeros, 9)
  let zb : Array[Byte] = []
  for i = 0; i < z.length(); i = i + 1 {
    zb.push(z[i])
  }
  zb[0] = (zb[0].to_int() ^ 0x80).to_byte()
  inspect(falcon_comp_decode(Bytes::from_array(zb), 9).length(), content="0")
}

///|
test "falcon-m1-xof-cross-lane" {
  // Odd-size extracts must continue the same SHAKE256 stream as the
  // one-shot path (regression: lane byte-cursor resumption).
  let h1 = shake_256_new()
  sha3_update(h1, b"falcon-xof-lane")
  let a = shake_finalize(h1, 300)
  let x = falcon_xof_init()
  falcon_xof_inject(x, b"falcon-xof-lane")
  let b1 = falcon_xof_extract(x, 3)
  let b2 = falcon_xof_extract(x, 137)
  let b3 = falcon_xof_extract(x, 17)
  let b4 = falcon_xof_extract(x, 143)
  let got = concat4(b1, b2, b3, b4)
  let mut ok = got.length() == 300
  for i = 0; i < 300; i = i + 1 {
    if got[i] != a[i] {
      ok = false
    }
  }
  inspect(ok, content="true")
}

///|
fn concat4(a : Bytes, b : Bytes, c : Bytes, d : Bytes) -> Bytes {
  let arr : Array[Byte] = []
  for x in [a, b, c, d] {
    for i = 0; i < x.length(); i = i + 1 {
      arr.push(x[i])
    }
  }
  Bytes::from_array(arr)
}
