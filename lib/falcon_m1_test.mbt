  let bad = m1_arr_eq([dec[0]], [x[0]])
  inspect(bad, content="true")
  let y : Array[Int] = []
  for u = 0; u < 512; u = u + 1 {
    y.push(12289)
  }
  inspect(falcon_modq_encode(y, 9).length(), content="0")
}

