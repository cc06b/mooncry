// Falcon M3 tests: the official PQClean C reference signatures (from
// falcon512_vectors.txt, deterministic harness) must verify; tampered
// inputs must not.

///|
fn m3_msg_a(t : Int, len : Int) -> Bytes {
  let a : Array[Byte] = []
  for i = 0; i < len; i = i + 1 {
    a.push(((i * 31 + t * 7) & 0xFF).to_byte())
  }
  Bytes::from_array(a)
}

///|
fn m3_msg_b(len : Int) -> Bytes {
  let a : Array[Byte] = []
  for i = 0; i < len; i = i + 1 {
    a.push(((255 - i) & 0xFF).to_byte())
  }
  Bytes::from_array(a)
}

