///|
test "falcon-m3-verify-official-sig0" {
  let msg = m3_msg_a(0, 0)
  inspect(falcon512_verify(m3_pk(), m3_sig0(), msg), content="true")
  // tampered message must fail
  let bad = m3_msg_a(0, 0)
  let cat : Array[Byte] = []
  for i = 0; i < bad.length(); i = i + 1 {
    cat.push(bad[i])
  }
  cat.push((0).to_byte())
  inspect(
    falcon512_verify(m3_pk(), m3_sig0(), Bytes::from_array(cat)),
    content="false",
  )
}

///|
test "falcon-m3-verify-official-sig1" {
  let msg = m3_msg_a(1, 3)
  inspect(falcon512_verify(m3_pk(), m3_sig1(), msg), content="true")
  // tampered message must fail
  let bad = m3_msg_a(1, 3)
  let cat : Array[Byte] = []
  for i = 0; i < bad.length(); i = i + 1 {
    cat.push(bad[i])
  }
  cat.push((0).to_byte())
  inspect(
    falcon512_verify(m3_pk(), m3_sig1(), Bytes::from_array(cat)),
    content="false",
  )
}

///|
test "falcon-m3-verify-official-sig2" {
  let msg = m3_msg_a(2, 64)
  inspect(falcon512_verify(m3_pk(), m3_sig2(), msg), content="true")
  // tampered message must fail
  let bad = m3_msg_a(2, 64)
  let cat : Array[Byte] = []
  for i = 0; i < bad.length(); i = i + 1 {
    cat.push(bad[i])
  }
  cat.push((0).to_byte())
  inspect(
    falcon512_verify(m3_pk(), m3_sig2(), Bytes::from_array(cat)),
    content="false",
  )
}

///|
test "falcon-m3-verify-official-sig3" {
  let msg = m3_msg_a(3, 200)
  inspect(falcon512_verify(m3_pk(), m3_sig3(), msg), content="true")
  // tampered message must fail
  let bad = m3_msg_a(3, 200)
  let cat : Array[Byte] = []
  for i = 0; i < bad.length(); i = i + 1 {
    cat.push(bad[i])
  }
  cat.push((0).to_byte())
  inspect(
    falcon512_verify(m3_pk(), m3_sig3(), Bytes::from_array(cat)),
    content="false",
  )
}

///|
test "falcon-m3-verify-second-key" {
  inspect(falcon512_verify(m3_pk2(), m3_sig2b(), m3_msg_b(33)), content="true")
}

///|
test "falcon-m3-tamper-nonce" {
  // Flipping a nonce byte changes hash_to_point output entirely; the
  // reconstructed s1 blows up and the norm bound rejects. (A single
  // flipped bit inside the comp body can legitimately stay short, so
  // the nonce is the meaningful tamper point.)
  let s = m3_sig0()
  let a : Array[Byte] = []
  for i = 0; i < s.length(); i = i + 1 {
    a.push(s[i])
  }
  a[5] = (a[5].to_int() ^ 0x80).to_byte()
  inspect(
    falcon512_verify(m3_pk(), Bytes::from_array(a), m3_msg_a(0, 0)),
    content="false",
  )
}

///|
test "falcon-m3-header-reject" {
  let s = m3_sig0()
  let a : Array[Byte] = []
  for i = 0; i < s.length(); i = i + 1 {
    a.push(s[i])
  }
  a[0] = (0x3A).to_byte()
  inspect(
    falcon512_verify(m3_pk(), Bytes::from_array(a), m3_msg_a(0, 0)),
    content="false",
  )
}
